8.':s?'\u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u092e\u0940\u0932 \u0915\u093e \u092a\u0924\u094d\u0925\u0930, \u0936\u093f\u0932\u093e\u0928\u094d\u092f\u093e\u0938, \u0935\u093f\u0935\u093e\u0939, \u092a\u0926\u094b\u0928\u094d\u0928\u0924\u093f \u090f\u0935\u0902 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u0938\u092e\u093e\u0930\u094b\u0939\u0964':'Milestones, long-term foundation stones, marriages, promotions, ceremonies.'}}},e.GET_LOCALIZED_TITHI_GUIDANCE=function(t,n){var s='hi'===n,o='gu'===n,h='hinglish'===n,l='mr'===n;switch(t){case 1:return{title:o?'\u0a8f\u0a95\u0aae / \u0aaa\u0aa1\u0ab5\u0acb (Pratipada 1st)':s?'\u092a\u094d\u0930\u0924\u093f\u092a\u0926\u093e (\u092a\u094d\u0930\u0925\u092e \u0924\u093f\u0925\u093f)':'Pratipada (1st)',type:'CHALLENGING',detail:o?'\u0ab6\u0ac1\u0a95\u0acd\u0ab2 \u0aaa\u0a95\u0acd\u0ab7\u0aa8\u0ac0 \u0a8f\u0a95\u0aae \u0aad\u0acc\u0aa4\u0abf\u0a95 \u0a95\u0abe\u0ab0\u0acd\u0aaf\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0aa8\u0aac\u0ab3\u0ac0 \u0a97\u0aa3\u0abe\u0aaf \u0a9b\u0ac7, \u0aaa\u0ab0\u0a82\u0aa4\u0ac1 \u0aa7\u0abe\u0ab0\u0acd\u0aae\u0abf\u0a95 \u0ab5\u0abf\u0aa7\u0abf\u0a93 \u0a85\u0aa8\u0ac7 \u0aae\u0a82\u0aa4\u0acd\u0ab0 \u0ab8\u0abe\u0aa7\u0aa8\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a89\u0aa4\u0acd\u0aa4\u0aae \u0a9b\u0ac7.':s?'\u0936\u0941\u0915\u094d\u0932 \u092a\u0915\u094d\u0937 \u092a\u094d\u0930\u0924\u093f\u092a\u0926\u093e \u092d\u094c\u0924\u093f\u0915 \u0915\u093e\u0930\u094d\u092f\u094b\u0902 \u0939\u0947\u0924\u0941 \u092e\u0927\u094d\u092f\u092e \u092e\u093e\u0928\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948, \u092a\u0930\u0902\u0924\u0941 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u0905\u0928\u0941\u0937\u094d\u0920\u093e\u0928 \u090f\u0935\u0902 \u092e\u0902\u0924\u094d\u0930 \u0938\u093e\u0927\u0928\u093e \u0915\u0947 \u0932\u093f\u090f \u0909\u0924\u094d\u0924\u092e \u0939\u0948\u0964':h?'Considered weak for constructive material work in Shukla Paksha, though favorable for starting sacred rites. Krishna Pratipada is moderately auspicious.':l?'\u0936\u0941\u0915\u094d\u0932 \u092a\u0915\u094d\u0937 \u092a\u094d\u0930\u0924\u093f\u092a\u0926\u093e \u092d\u094c\u0924\u093f\u0915 \u0915\u093e\u092e\u093e\u0902\u0938\u093e\u0920\u0940 \u092e\u0927\u094d\u092f\u092e, \u092a\u0930\u0902\u0924\u0941 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u0935\u093f\u0927\u0940 \u0935 \u0938\u093e\u0927\u0928\u093e \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0924\u094d\u092f\u0902\u0924 \u0936\u0941\u092d \u092e\u093e\u0928\u0932\u0940 \u091c\u093e\u0924\u0947.':'Considered weak for constructive material work in Shukla Paksha, though favorable for starting sacred rites.'};case 2:return{title:o?'\u0aac\u0ac0\u0a9c (Dwitiya 2nd)':s?'\u0926\u094d\u0935\u093f\u0924\u0940\u092f\u093e (\u0926\u094d\u0935\u093f\u0924\u0940\u092f \u0924\u093f\u0925\u093f)':'Dwitiya (2nd)',type:'FRUITFUL',detail:o?'\u0a97\u0ac3\u0ab9\u0aaa\u0acd\u0ab0\u0ab5\u0ac7\u0ab6, \u0aa8\u0ab5\u0ac1\u0a82 \u0aae\u0a95\u0abe\u0aa8 \u0aac\u0abe\u0a82\u0aa7\u0ab5\u0ac1\u0a82, \u0aa8\u0abe\u0aa3\u0abe\u0a95\u0ac0\u0aaf \u0ab5\u0acd\u0aaf\u0ab5\u0ab9\u0abe\u0ab0\u0acb \u0a85\u0aa8\u0ac7 \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0ac0 \u0ab6\u0ab0\u0ac2 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0aa4\u0acd\u0aaf\u0a82\u0aa4 \u0ab6\u0ac1\u0aad \u0aa4\u0abf\u0aa5\u0abf.':s?'\u0917\u0943\u0939 \u092a\u094d\u0930\u0935\u0947\u0936, \u092d\u0935\u0928 \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u092a\u094d\u0930\u093e\u0930\u0902\u092d, \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0932\u0947\u0928\u0926\u0947\u0928 \u090f\u0935\u0902 \u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u0938\u093e\u091d\u0947\u0926\u093e\u0930\u0940 \u0939\u0947\u0924\u0941 \u0905\u0924\u094d\u092f\u0902\u0924 \u0936\u0941\u092d \u0924\u093f\u0925\u093f\u0964':h?'Highly favorable for commencing construction, entering a new home (Griha Pravesh), financial dealings, and entering partnerships.':l?'\u0917\u0943\u0939\u092a\u094d\u0930\u0935\u0947\u0936, \u0928\u0935\u0940\u0928 \u0935\u093e\u0938\u094d\u0924\u0942 \u0928\u093f\u0930\u094d\u092e\u093e\u0923, \u0906\u0930\u094d\u0925\u093f\u0915 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0906\u0923\u093f \u092d\u093e\u0917\u0940\u0926\u093e\u0930\u0940 \u0938\u0941\u0930\u0942 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0924\u094d\u092f\u0902\u0924 \u0936\u0941\u092d \u0924\u093f\u0925\u0940.':'Highly favorable for commencing construction, entering a new home (Griha Pravesh), financial dealings, and entering partnerships.'};case 3:return{title:o?'\u0aa4\u0acd\u0ab0\u0ac0\u0a9c (Tritiya 3rd)':s?'\u0924\u0943\u0924\u0940\u092f\u093e (\u0924\u0943\u0924\u0940\u092f \u0924\u093f\u0925\u093f)':'Tritiya (3rd)',type:'FRUITFUL',detail:o?'\u0ab0\u0a9a\u0aa8\u0abe\u0aa4\u0acd\u0aae\u0a95 \u0a95\u0abe\u0ab0\u0acd\u0aaf\u0acb, \u0a95\u0ab3\u0abe, \u0ab8\u0a82\u0a97\u0ac0\u0aa4, \u0ab2\u0a97\u0acd\u0aa8 \u0a85\u0aa8\u0ac7 \u0aa8\u0ab5\u0ac0 \u0ab8\u0acd\u0aaa\u0ab0\u0acd\u0aa7\u0abe\u0aa4\u0acd\u0aae\u0a95 \u0aaa\u0ab9\u0ac7\u0ab2 \u0aae\u0abe\u0a9f\u0ac7 \u0a89\u0aa4\u0acd\u0aa4\u0aae \u0aa4\u0abf\u0aa5\u0abf.':s?'\u0930\u091a\u0928\u093e\u0924\u094d\u092e\u0915 \u0915\u093e\u0930\u094d\u092f, \u0915\u0932\u093e, \u0938\u0902\u0917\u0940\u0924, \u0935\u093f\u0935\u093e\u0939 \u090f\u0935\u0902 \u0928\u090f \u0930\u0923\u0928\u0940\u0924\u093f\u0915 \u092a\u094d\u0930\u092f\u093e\u0938\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0905\u0924\u093f \u0909\u0924\u094d\u0924\u092e\u0964':h?'Excellent for creative ventures, arts, weddings, and taking competitive initiatives.':l?'\u0915\u0932\u093e\u0924\u094d\u092e\u0915 \u0915\u093e\u092e\u0947, \u0938\u0902\u0917\u0940\u0924, \u0935\u093f\u0935\u093e\u0939 \u0906\u0923\u093f \u0928\u0935\u0940\u0928 \u0927\u094b\u0930\u0923\u093e\u0924\u094d\u092e\u0915 \u0909\u092a\u0915\u094d\u0930\u092e \u0938\u0941\u0930\u0942 \u0915\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0909\u0924\u094d\u0924\u092e.':'Excellent for creative ventures, arts, weddings, and taking competitive initiatives.'};case 4:return{title:o?'\u0a9a\u0acb\u0aa5 (Chaturthi 4th - Rikta)':s?'\u091a\u0924\u0941\u0930\u094d\u0925\u0940 (\u0930\u093f\u0915\u094d\u0924\u093e \u0924\u093f\u0925\u093f)':'Chaturthi (4th - Rikta)',type:'CHALLENGING',detail:o?'\u0ab0\u0acb\u0a95\u0abe\u0aa3, \u0aaf\u0abe\u0aa4\u0acd\u0ab0\u0abe \u0a95\u0ac7 \u0aa8\u0ab5\u0abe \u0a95\u0ab0\u0abf\u0aaf\u0ab0 \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab6\u0ac1\u0aad; \u0a97\u0aa3\u0ac7\u0ab6 \u0aaa\u0ac2\u0a9c\u0aa8 \u0a85\u0aa8\u0ac7 \u0ab5\u0abf\u0a98\u0acd\u0aa8\u0aa8\u0abf\u0ab5\u0abe\u0ab0\u0aa3 \u0aae\u0abe\u0a9f\u0ac7 \u0ab6\u0acd\u0ab0\u0ac7\u0ab7\u0acd\u0aa0.':s?'\u0928\u093f\u0935\u0947\u0936, \u092f\u093e\u0924\u094d\u0930\u093e \u092f\u093e \u0928\u090f \u0915\u0930\u093f\u092f\u0930 \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0939\u0947\u0924\u0941 \u0905\u0936\u0941\u092d; \u0917\u0923\u0947\u0936 \u092a\u0942\u091c\u0928 \u090f\u0935\u0902 \u092c\u093e\u0927\u093e \u0928\u093f\u0935\u093e\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0936\u094d\u0930\u0947\u0937\u094d\u0920\u0964':h?'Unfavorable for investments, travel, or starting a new career; suitable for overcoming obstacles (worship of Ganesha) or counter-adversary actions.':l?'\u0917\u0941\u0902\u0924\u0935\u0923\u0942\u0915, \u092a\u094d\u0930\u0935\u093e\u0938 \u0915\u093f\u0902\u0935\u093e \u0928\u0935\u0940\u0928 \u0915\u0930\u093f\u0905\u0930\u0938\u093e\u0920\u0940 \u0935\u0930\u094d\u091c\u094d\u092f; \u0917\u0923\u0947\u0936 \u092a\u0942\u091c\u0928 \u0935 \u0938\u0902\u0915\u091f \u0928\u093f\u0935\u093e\u0930\u0923\u093e\u0938\u093e\u0920\u0940 \u0909\u0924\u094d\u0924\u092e.':'Unfavorable for investments, travel, or starting a new career; suitable for overcoming obstacles.'};case 5:return{title:o?'\u0aaa\u0abe\u0a82\u0a9a\u0aae (Panchami 5th)':s?'\u092a\u0902\u091a\u092e\u0940 (\u092a\u0902\u091a\u092e \u0924\u093f\u0925\u093f)':'Panchami (5th)',type:'FRUITFUL',detail:o?'\u0ab6\u0abf\u0a95\u0acd\u0ab7\u0aa3, \u0ab5\u0abf\u0aa6\u0acd\u0aaf\u0abe\u0aad\u0acd\u0aaf\u0abe\u0ab8, \u0aa4\u0aac\u0ac0\u0aac\u0ac0 \u0ab8\u0abe\u0ab0\u0ab5\u0abe\u0ab0 \u0a85\u0aa8\u0ac7 \u0aa8\u0ab5\u0ac1\u0a82 \u0a9c\u0acd\u0a9e\u0abe\u0aa8 \u0aae\u0ac7\u0ab3\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0aa4\u0acd\u0aaf\u0a82\u0aa4 \u0ab6\u0ac1\u0aad.':s?'\u0936\u093f\u0915\u094d\u0937\u093e, \u092a\u0920\u0928-\u092a\u093e\u0920\u0928, \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u090f\u0935\u0902 \u092c\u094c\u0926\u094d\u0927\u093f\u0915 \u0915\u093e\u0930\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0905\u0924\u094d\u092f\u0902\u0924 \u0936\u0941\u092d\u0964':h?'Auspicious for education, medical treatments, learning new subjects, and intellectual pursuits.':l?'\u0936\u093f\u0915\u094d\u0937\u0923, \u0928\u0935\u0940\u0928 \u0935\u093f\u0926\u094d\u092f\u093e \u0917\u094d\u0930\u0939\u0923, \u0935\u0948\u0926\u094d\u092f\u0915\u0940\u092f \u0909\u092a\u091a\u093e\u0930 \u0906\u0923\u093f \u092c\u094c\u0926\u094d\u0927\u093f\u0915 \u0915\u093e\u092e\u093e\u0902\u0938\u093e\u0920\u0940 \u0905\u0924\u094d\u092f\u0902\u0924 \u0936\u0941\u092d.':'Auspicious for education, medical treatments, learning new subjects, and intellectual pursuits.'};case 6:return{title:o?'\u0a9b\u0aa0 (Shashthi 6th)':s?'\u0937\u0937\u094d\u0920\u0940 (\u091b\u0920\u0940 \u0924\u093f\u0925\u093f)':'Shashthi (6th)',type:'CHALLENGING',detail:o?'\u0a98\u0ab0\u0ac7\u0ab2\u0ac1 \u0aa8\u0ab5\u0abe \u0a95\u0abe\u0ab0\u0acd\u0aaf\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0a9a\u0a82\u0a9a\u0ab3; \u0ab8\u0acd\u0aaa\u0ab0\u0acd\u0aa7\u0abe\u0aa4\u0acd\u0aae\u0a95 \u0a95\u0abe\u0ab0\u0acd\u0aaf\u0acb, \u0a86\u0ab0\u0acb\u0a97\u0acd\u0aaf \u0ab8\u0ac1\u0aa7\u0abe\u0ab0 \u0a85\u0aa8\u0ac7 \u0ab0\u0a95\u0acd\u0ab7\u0aa3\u0abe\u0aa4\u0acd\u0aae\u0a95 \u0a95\u0abe\u0ab0\u0acd\u0aaf \u0aae\u0abe\u0a9f\u0ac7 \u0a89\u0aa4\u0acd\u0aa4\u0aae.':s?'\u092a\u093e\u0930\u093f\u0935\u093e\u0930\u093f\u0915 \u0915\u093e\u0930\u094d\u092f\u094b\u0902 \u0939\u0947\u0924\u0941 \u091a\u0902\u091a\u0932; \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u092a\u0930\u094d\u0927\u093e, \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0938\u0902\u0935\u0930\u094d\u0927\u0928 \u090f\u0935\u0902 \u0938\u0941\u0930\u0915\u094d\u0937\u093e\u0924\u094d\u092e\u0915 \u0915\u093e\u0930\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u0941\u0915\u094d\u0924\u0964':h?'Often volatile for domestic beginnings; better suited for competitive tasks, defense, or health building.':l?'\u0918\u0930\u0917\u0941\u0924\u0940 \u0915\u093e\u092e\u093e\u0902\u0938\u093e\u0920\u0940 \u091a\u0902\u091a\u0932; \u0938\u094d\u092a\u0930\u094d\u0927\u093e, \u0906\u0930\u094b\u0917\u094d\u092f \u0938\u0941\u0927\u093e\u0930\u0923\u093e \u0906\u0923\u093f \u0938\u0902\u0930\u0915\u094d\u0937\u0923\u093e\u0924\u094d\u092e\u0915 \u0915\u093e\u092e\u093e\u0902\u0938\u093e\u0920\u0940 \u0909\u0924\u094d\u0924\u092e.':'Often volatile for domestic beginnings; better suited for competitive tasks, defense, or health building.'};case 7:return{title:o?'\u0ab8\u0abe\u0aa4\u0aae (Saptami 7th)':s?'\u0938\u092a\u094d\u0924\u092e\u0940 (\u0938\u092a\u094d\u0924\u092e \u0924\u093f\u0925\u093f)':'Saptami (7th)',type:'FRUITFUL',detail:o?'\u0ab2\u0abe\u0a82\u0aac\u0ac0 \u0aaf\u0abe\u0aa4\u0acd\u0ab0\u0abe \u0ab6\u0ab0\u0ac2 \u0a95\u0ab0\u0ab5\u0abe, \u0ab5\u0abe\u0ab9\u0aa8 \u0a96\u0ab0\u0ac0\u0aa6\u0ab5\u0abe, \u0a95\u0ab0\u0abe\u0ab0 \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0aa8\u0ac7 \u0a9c\u0abe\u0ab9\u0ac7\u0ab0 \u0a9c\u0ab5\u0abe\u0aac\u0aa6\u0abe\u0ab0\u0ac0\u0a93 \u0ab8\u0acd\u0ab5\u0ac0\u0a95\u0abe\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a89\u0aa4\u0acd\u0aa4\u0aae.':s?'\u0926\u0940\u0930\u094d\u0918 \u092f\u093e\u0924\u094d\u0930\u093e \u092a\u094d\u0930\u093e\u0930\u0902\u092d, \u0935\u093e\u0939\u0928 \u0915\u094d\u0930\u092f, \u0905\u0928\u0941\u092c\u0902\u0927 \u0915\u0930\u0928\u0947 \u090f\u0935\u0902 \u0928\u090f \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0909\u0924\u094d\u0924\u0930\u0926\u093e\u092f\u093f\u0924\u094d\u0935 \u0939\u0947\u0924\u0941 \u0909\u0924\u094d\u0924\u092e\u0964':h?'Ideal for beginning long-distance journeys, buying vehicles, entering contracts, and taking up public responsibilities.':l?'\u0926\u0940\u0930\u094d\u0918 \u092a\u094d\u0930\u0935\u093e\u0938, \u0935\u093e\u0939\u0928 \u0916\u0930\u0947\u0926\u0940, \u0915\u0930\u093e\u0930 \u0915\u0930\u0923\u0947 \u0935 \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u091c\u092c\u093e\u092c\u0926\u093e\u0931\u094d\u092f\u093e \u0938\u094d\u0935\u0940\u0915\u093e\u0930\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0909\u0924\u094d\u0924\u092e.':'Ideal for beginning long-distance journeys, buying vehicles, entering contracts, and taking up public responsibilities.'};case 8:return{title:o?'\u0a86\u0aa0\u0aae (Ashtami 8th)':s?'\u0905\u0937\u094d\u091f\u092e\u0940 (\u0905\u0937\u094d\u091f\u092e \u0924\u093f\u0925\u093f)':'Ashtami (8th)',type:'CHALLENGING',detail:o?'\u0ab2\u0a97\u0acd\u0aa8 \u0a95\u0ac7 \u0aaf\u0abe\u0aa4\u0acd\u0ab0\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a9f\u0abe\u0ab3\u0ab5\u0ac0; \u0aa6\u0ac1\u0ab0\u0acd\u0a97\u0abe \u0aaa\u0ac2\u0a9c\u0aa8, \u0ab6\u0a95\u0acd\u0aa4\u0abf \u0ab8\u0abe\u0aa7\u0aa8\u0abe \u0a85\u0aa8\u0ac7 \u0a95\u0aa0\u0abf\u0aa8 \u0a95\u0abe\u0ab0\u0acd\u0aaf\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0ab6\u0acd\u0ab0\u0ac7\u0ab7\u0acd\u0aa0.':s?'\u0935\u093f\u0935\u093e\u0939 \u090f\u0935\u0902 \u092f\u093e\u0924\u094d\u0930\u093e \u0939\u0947\u0924\u0941 \u0935\u0930\u094d\u091c\u093f\u0924; \u0926\u0941\u0930\u094d\u0917\u093e \u092a\u0942\u091c\u0928, \u0936\u0915\u094d\u0924\u093f \u0938\u093e\u0927\u0928\u093e \u090f\u0935\u0902 \u0915\u0920\u094b\u0930 \u0915\u093e\u0930\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0909\u0924\u094d\u0924\u092e\u0964':h?'Known for volatility and dual nature. Generally avoided for weddings and travel; favorable for protective, rigorous, or competitive tasks.':l?'\u0935\u093f\u0935\u093e\u0939 \u0935 \u092a\u094d\u0930\u0935\u093e\u0938\u093e\u0938\u093e\u0920\u0940 \u0935\u0930\u094d\u091c\u094d\u092f; \u0926\u0941\u0930\u094d\u0917\u093e \u092a\u0942\u091c\u0928, \u0936\u0915\u094d\u0924\u0940 \u0938\u093e\u0927\u0928\u093e \u0935 \u0915\u0920\u0940\u0923 \u0915\u093e\u092e\u093e\u0902\u0938\u093e\u0920\u0940 \u0936\u0941\u092d.':'Generally avoided for weddings and travel; favorable for protective, rigorous, or competitive tasks.'};case 9:return{title:o?'\u0aa8\u0acb\u0aae (Navami 9th - Rikta)':s?'\u0928\u0935\u092e\u0940 (\u0930\u093f\u0915\u094d\u0924\u093e \u0924\u093f\u0925\u093f)':'Navami (9th - Rikta)',type:'CHALLENGING',detail:o?'\u0aae\u0a95\u0abe\u0aa8 \u0a96\u0ab0\u0ac0\u0aa6\u0ac0, \u0ab2\u0a97\u0acd\u0aa8 \u0a95\u0ac7 \u0aa8\u0ab5\u0acb \u0ab5\u0ac7\u0aaa\u0abe\u0ab0 \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab6\u0ac1\u0aad; \u0a95\u0abe\u0aaf\u0aa6\u0abe\u0a95\u0ac0\u0aaf \u0ab5\u0abf\u0ab5\u0abe\u0aa6\u0acb \u0a85\u0aa8\u0ac7 \u0ab6\u0aa4\u0acd\u0ab0\u0ac1 \u0ab5\u0abf\u0a9c\u0aaf \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0aa8\u0ac1\u0a95\u0ac2\u0ab3.':s?'\u0938\u0902\u092a\u0924\u094d\u0924\u093f \u0915\u094d\u0930\u092f, \u0935\u093f\u0935\u093e\u0939 \u092f\u093e \u0928\u092f\u093e \u0935\u094d\u092f\u093e\u092a\u093e\u0930 \u0939\u0947\u0924\u0941 \u0905\u0928\u0941\u092f\u0941\u0915\u094d\u0924; \u0915\u093e\u0928\u0942\u0928\u0940 \u0935\u093f\u0935\u093e\u0926 \u090f\u0935\u0902 \u092c\u093e\u0927\u093e \u0928\u093f\u0935\u093e\u0930\u0923 \u0939\u0947\u0924\u0941 \u0905\u0928\u0941\u0915\u0942\u0932\u0964':h?'Unsuitable for constructive beginnings (buying property, marriage, business). Favorable for combat, legal confrontation, and purging.':l?'\u0935\u093e\u0938\u094d\u0924\u0942 \u0916\u0930\u0947\u0926\u0940, \u0935\u093f\u0935\u093e\u0939 \u0935\u093e \u0928\u0935\u0940\u0928 \u0935\u094d\u092f\u093e\u092a\u093e\u0930\u093e\u0938\u093e\u0920\u0940 \u0905\u092f\u094b\u0917\u094d\u092f; \u0915\u093e\u092f\u0926\u0947\u0936\u0940\u0930 \u0935\u093f\u0935\u093e\u0926 \u0935 \u0936\u0924\u094d\u0930\u0942 \u0935\u093f\u091c\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0928\u0941\u0915\u0942\u0932.':'Unsuitable for constructive beginnings. Favorable for combat, legal confrontation, and purging.'};case 10:return{title:o?'\u0aa6\u0ab8\u0aae (Dashami 10th)':s?'\u0926\u0936\u092e\u0940 (\u0926\u0936\u092e \u0924\u093f\u0925\u093f)':'Dashami (10th)',type:'FRUITFUL',detail:o?'\u0ab8\u0ab0\u0a95\u0abe\u0ab0\u0ac0 \u0a95\u0abe\u0ab0\u0acd\u0aaf\u0acb, \u0aa8\u0ab5\u0acb \u0ab5\u0ac7\u0aaa\u0abe\u0ab0 \u0ab6\u0ab0\u0ac2 \u0a95\u0ab0\u0ab5\u0abe, \u0ab5\u0ab9\u0ac0\u0ab5\u0a9f \u0a85\u0aa8\u0ac7 \u0ab8\u0aa8\u0acd\u0aae\u0abe\u0aa8 \u0aae\u0ac7\u0ab3\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab8\u0acc\u0aa5\u0ac0 \u0aae\u0a9c\u0aac\u0ac2\u0aa4 \u0aa4\u0abf\u0aa5\u0abf.':s?'\u0938\u0930\u0915\u093e\u0930\u0940 \u0915\u093e\u0930\u094d\u092f, \u0928\u092f\u093e \u0935\u094d\u092f\u093e\u092a\u093e\u0930 \u092a\u094d\u0930\u093e\u0930\u0902\u092d, \u092a\u094d\u0930\u0936\u093e\u0938\u0928\u093f\u0915 \u0915\u093e\u0930\u094d\u092f \u090f\u0935\u0902 \u092a\u094d\u0930\u0924\u093f\u0937\u094d\u0920\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f \u0939\u0947\u0924\u0941 \u0905\u0924\u094d\u092f\u0902\u0924 \u092c\u0932\u0935\u093e\u0928 \u0924\u093f\u0925\u093f\u0964':h?'One of the strongest Tithis for government-related works, launching businesses, administration, and public recognition.':l?'\u0936\u093e\u0938\u0915\u0940\u092f \u0915\u093e\u092e\u0947, \u0928\u0935\u0940\u0928 \u0935\u094d\u092f\u0935\u0938\u093e\u092f \u092a\u094d\u0930\u093e\u0930\u0902\u092d, \u092a\u094d\u0930\u0936\u093e\u0938\u0928 \u0935 \u0938\u0928\u094d\u092e\u093e\u0928 \u092e\u093f\u0933\u0935\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0924\u094d\u092f\u0902\u0924 \u092c\u0932\u0935\u093e\u0928 \u0924\u093f\u0925\u0940.':'One of the strongest Tithis for government-related works, launching businesses, administration, and public recognition.'};case 11:return{title:o?'\u0a85\u0a97\u0abf\u0aaf\u0abe\u0ab0\u0ab8 (Ekadashi 11th)':s?'\u090f\u0915\u093e\u0926\u0936\u0940 (\u090f\u0915\u093e\u0926\u0936 \u0924\u093f\u0925\u093f)':'Ekadashi (11th)',type:'FRUITFUL',detail:o?'\u0a89\u0aaa\u0ab5\u0abe\u0ab8, \u0a86\u0aa7\u0acd\u0aaf\u0abe\u0aa4\u0acd\u0aae\u0abf\u0a95 \u0aaa\u0acd\u0ab0\u0a97\u0aa4\u0abf, \u0aa6\u0abe\u0aa8 \u0a85\u0aa8\u0ac7 \u0aa7\u0acd\u0aaf\u0abe\u0aa8 \u0aae\u0abe\u0a9f\u0ac7 \u0ab6\u0acd\u0ab0\u0ac7\u0ab7\u0acd\u0aa0. \u0aa4\u0aae\u0abe\u0aae \u0aaa\u0ab5\u0abf\u0aa4\u0acd\u0ab0 \u0a95\u0abe\u0ab0\u0acd\u0aaf\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0aa4\u0acd\u0aaf\u0a82\u0aa4 \u0aaa\u0ac2\u0a9c\u0aa8\u0ac0\u0aaf.':s?'\u0935\u094d\u0930\u0924, \u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u0909\u0928\u094d\u0928\u0924\u093f, \u0926\u093e\u0928 \u090f\u0935\u0902 \u0927\u094d\u092f\u093e\u0928 \u0939\u0947\u0924\u0941 \u0936\u094d\u0930\u0947\u0937\u094d\u0920\u0964 \u0938\u092e\u0938\u094d\u0924 \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u0915\u093e\u0930\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092a\u0930\u092e \u092a\u0935\u093f\u0924\u094d\u0930\u0964':h?'Excellent for fasting, spiritual elevation, charity, and meditation. Generally considered sacred for all virtuous acts.':l?'\u0909\u092a\u0935\u093e\u0938, \u0905\u0927\u094d\u092f\u093e\u0924\u094d\u092e, \u0926\u093e\u0928 \u0935 \u0927\u094d\u092f\u093e\u0928\u093e\u0938\u093e\u0920\u0940 \u0905\u0924\u094d\u092f\u0902\u0924 \u0936\u094d\u0930\u0947\u0937\u094d\u0920 \u0935 \u092a\u0935\u093f\u0924\u094d\u0930 \u0924\u093f\u0925\u0940.':'Excellent for fasting, spiritual elevation, charity, and meditation.'};case 12:return{title:o?'\u0aac\u0abe\u0ab0\u0ab8 (Dwadashi 12th)':s?'\u0926\u094d\u0935\u093e\u0926\u0936\u0940 (\u0926\u094d\u0935\u093e\u0926\u0936 \u0924\u093f\u0925\u093f)':'Dwadashi (12th)',type:'FRUITFUL',detail:o?'\u0ab5\u0acd\u0ab0\u0aa4\u0aa8\u0ac1\u0a82 \u0aaa\u0abe\u0ab0\u0aa3\u0ac1\u0a82, \u0aae\u0acb\u0a9f\u0abe \u0a95\u0ab0\u0abe\u0ab0\u0acb, \u0ab6\u0abf\u0a95\u0acd\u0ab7\u0aa3 \u0a85\u0aa8\u0ac7 \u0aa8\u0abe\u0aa3\u0abe\u0a95\u0ac0\u0aaf \u0aaa\u0abe\u0aaf\u0acb \u0aa8\u0abe\u0a96\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0aa4\u0acd\u0aaf\u0a82\u0aa4 \u0ab6\u0ac1\u0aad.':s?'\u0935\u094d\u0930\u0924 \u092a\u093e\u0930\u0923, \u0926\u0940\u0930\u094d\u0918\u0915\u093e\u0932\u093f\u0915 \u0905\u0928\u0941\u092c\u0902\u0927, \u0936\u093f\u0915\u094d\u0937\u093e \u090f\u0935\u0902 \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0928\u0940\u0935 \u0930\u0916\u0928\u0947 \u0939\u0947\u0924\u0941 \u0905\u0924\u094d\u092f\u0902\u0924 \u0936\u0941\u092d\u0964':h?'Auspicious for completing vows, major contracts, education, and long-term financial foundations.':l?'\u0935\u094d\u0930\u0924 \u092a\u093e\u0930\u0923\u0947, \u092e\u094b\u0920\u0947 \u0915\u0930\u093e\u0930, \u0936\u093f\u0915\u094d\u0937\u0923 \u0935 \u0906\u0930\u094d\u0925\u093f\u0915 \u092a\u093e\u092f\u093e \u0930\u091a\u0923\u094d\u092f\u093e\u0938\u093e\u0920\u0940 \u0905\u0924\u094d\u092f\u0902\u0924 \u0936\u0941\u092d.':'Auspicious for completing vows, major contracts, education, and long-term financial foundations.'};case 13:return{title:o?'\u0aa4\u0ac7\u0ab0\u0ab8 (Trayodashi 13th)':s?'\u0924\u094d\u0930\u092f\u094b\u0926\u0936\u0940 (\u0924\u094d\u0930\u092f\u094b\u0926\u0936 \u0924\u093f\u0925\u093f)':'Trayodashi (13th)',type:'FRUITFUL',detail:o?'\u0ab6\u0abe\u0a82\u0aa4\u0abf \u0ab8\u0acd\u0aa5\u0abe\u0aaa\u0ab5\u0abe, \u0a86\u0aad\u0ac2\u0ab7\u0aa3 \u0a96\u0ab0\u0ac0\u0aa6\u0ab5\u0abe, \u0aae\u0abf\u0aa4\u0acd\u0ab0\u0aa4\u0abe \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aa6\u0acb\u0ab7 \u0ab5\u0acd\u0ab0\u0aa4 \u0aaa\u0ac2\u0a9c\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0aa4\u0abf \u0aab\u0ab3\u0aa6\u0abe\u0aaf\u0ac0.':s?'\u0938\u0926\u094d\u092d\u093e\u0935 \u0938\u094d\u0925\u093e\u092a\u0928\u093e, \u0935\u0938\u094d\u0924\u094d\u0930-\u0906\u092d\u0942\u0937\u0923 \u0915\u094d\u0930\u092f, \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u092e\u0947\u0932\u091c\u094b\u0932 \u090f\u0935\u0902 \u092a\u094d\u0930\u0926\u094b\u0937 \u0935\u094d\u0930\u0924 \u092a\u0942\u091c\u093e \u0939\u0947\u0924\u0941 \u0905\u0924\u093f \u092b\u0932\u0926\u093e\u092f\u0940\u0964':h?'Highly favorable for making peace, sensual arts, buying clothing/jewelry, socializing, and Pradosh Puja.':l?'\u0936\u093e\u0902\u0924\u0924\u093e \u092a\u094d\u0930\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0923\u0947, \u0926\u093e\u0917\u093f\u0928\u0947 \u0916\u0930\u0947\u0926\u0940, \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0938\u0902\u092c\u0902\u0927 \u0935 \u092a\u094d\u0930\u0926\u094b\u0937 \u092a\u0942\u091c\u0947\u0938\u093e\u0920\u0940 \u0905\u0924\u093f \u092b\u0932\u0926\u093e\u092f\u0940.':'Highly favorable for making peace, buying clothing/jewelry, socializing, and Pradosh Puja.'};case 14:return{title:o?'\u0a9a\u0acc\u0aa6\u0ab8 (Chaturdashi 14th - Rikta)':s?'\u091a\u0924\u0941\u0930\u094d\u0926\u0936\u0940 (\u0930\u093f\u0915\u094d\u0924\u093e \u0924\u093f\u0925\u093f)':'Chaturdashi (14th - Rikta)',type:'CHALLENGING',detail:o?'\u0ab2\u0a97\u0acd\u0aa8, \u0aaf\u0abe\u0aa4\u0acd\u0ab0\u0abe \u0a95\u0ac7 \u0aae\u0abf\u0ab2\u0a95\u0aa4 \u0a96\u0ab0\u0ac0\u0aa6\u0ac0 \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab6\u0ac1\u0aad; \u0ab6\u0abf\u0ab5 \u0ab8\u0abe\u0aa7\u0aa8\u0abe, \u0ab8\u0ab0\u0acd\u0a9c\u0ab0\u0ac0 \u0a85\u0aa8\u0ac7 \u0aa8\u0a95\u0abe\u0ab0\u0abe\u0aa4\u0acd\u0aae\u0a95\u0aa4\u0abe \u0aa6\u0ac2\u0ab0 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a89\u0aa4\u0acd\u0aa4\u0aae.':s?'\u0935\u093f\u0935\u093e\u0939, \u092f\u093e\u0924\u094d\u0930\u093e \u092f\u093e \u0938\u0902\u092a\u0924\u094d\u0924\u093f \u0915\u094d\u0930\u092f \u0939\u0947\u0924\u0941 \u0935\u0930\u094d\u091c\u093f\u0924; \u0936\u093f\u0935 \u0938\u093e\u0927\u0928\u093e, \u0936\u0932\u094d\u092f \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u093e \u090f\u0935\u0902 \u0928\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915\u0924\u093e \u0928\u093e\u0936 \u0939\u0947\u0924\u0941 \u0909\u0924\u094d\u0924\u092e\u0964':h?'Strictly avoided for standard auspicious events (weddings, journey, buying assets). Favorable for Shiva sadhana, medical surgeries, and eradicating negativity.':l?'\u0935\u093f\u0935\u093e\u0939, \u092a\u094d\u0930\u0935\u093e\u0938 \u0935\u093e \u0928\u0935\u0940\u0928 \u0916\u0930\u0947\u0926\u0940\u0938\u093e\u0920\u0940 \u0935\u0930\u094d\u091c\u094d\u092f; \u0936\u093f\u0935 \u0938\u093e\u0927\u0928\u093e \u0935 \u0936\u0932\u094d\u092f \u0915\u094d\u0930\u093f\u092f\u0947\u0938\u093e\u0920\u0940 \u0909\u0924\u094d\u0924\u092e.':'Strictly avoided for standard auspicious events. Favorable for Shiva sadhana and medical surgeries.'};case 15:return{title:o?'\u0aaa\u0ac2\u0aa8\u0aae / \u0aaa\u0ac2\u0ab0\u0acd\u0aa3\u0abf\u0aae\u0abe (Purnima 15th)':s?'\u092a\u0942\u0930\u094d\u0923\u093f\u092e\u093e (\u092a\u0942\u0930\u094d\u0923 \u0924\u093f\u0925\u093f)':'Purnima (15th / Full Moon)',type:'FRUITFUL',detail:o?'\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0aab\u0ab3\u0aa6\u0abe\u0aaf\u0ac0; \u0ab8\u0aa4\u0acd\u0aaf\u0aa8\u0abe\u0ab0\u0abe\u0aaf\u0aa3 \u0a95\u0aa5\u0abe, \u0aae\u0ab9\u0abe\u0aaa\u0ac2\u0a9c\u0abe, \u0ab9\u0ab5\u0aa8 \u0a85\u0aa8\u0ac7 \u0aa7\u0abe\u0ab0\u0acd\u0aae\u0abf\u0a95 \u0a89\u0aa4\u0acd\u0ab8\u0ab5\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0aa4\u0abf \u0a89\u0aa4\u0acd\u0aa4\u0aae.':s?'\u092a\u0942\u0930\u094d\u0923 \u092b\u0932\u0926\u093e\u092f\u0940; \u0938\u0924\u094d\u092f\u0928\u093e\u0930\u093e\u092f\u0923 \u0915\u0925\u093e, \u092e\u0939\u093e\u092a\u0942\u091c\u093e, \u0939\u0935\u0928 \u090f\u0935\u0902 \u092e\u093e\u0902\u0917\u0932\u093f\u0915 \u0906\u092f\u094b\u091c\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0938\u0930\u094d\u0935\u094b\u0924\u094d\u0924\u092e\u0964':h?'Complete fruition; ideal for spiritual ceremonies, Satyanarayan puja, homams, and grand community events.':l?'\u092a\u0942\u0930\u094d\u0923 \u092b\u0932\u0926\u093e\u092f\u0940; \u0938\u0924\u094d\u092f\u0928\u093e\u0930\u093e\u092f\u0923 \u092a\u0942\u091c\u093e, \u0939\u094b\u092e-\u0939\u0935\u0928 \u0935 \u092d\u0935\u094d\u092f \u0927\u093e\u0930\u094d\u092e\u093f\u0915 \u0915\u093e\u0930\u094d\u092f\u0915\u094d\u0930\u092e\u093e\u0902\u0938\u093e\u0920\u0940 \u0938\u0930\u094d\u0935\u094b\u0924\u094d\u0924\u092e.':'Complete fruition; ideal for spiritual ceremonies, Satyanarayan puja, homams, and grand community events.'};default:return{title:o?'\u0a85\u0aae\u0abe\u0ab8 / \u0a85\u0aae\u0abe\u0ab5\u0abe\u0ab8\u0acd\u0aaf\u0abe (Amavasya New Moon)':s?'\u0905\u092e\u093e\u0935\u0938\u094d\u092f\u093e (\u0905\u092e\u093e \u0924\u093f\u0925\u093f)':'Amavasya (New Moon)',type:'CHALLENGING',detail:o?'\u0ab5\u0ac7\u0aaa\u0abe\u0ab0, \u0ab2\u0a97\u0acd\u0aa8, \u0aaf\u0abe\u0aa4\u0acd\u0ab0\u0abe \u0a95\u0ac7 \u0a95\u0ab0\u0abe\u0ab0 \u0aae\u0abe\u0a9f\u0ac7 \u0a85\u0ab6\u0ac1\u0aad; \u0aaa\u0abf\u0aa4\u0ac3 \u0aa4\u0ab0\u0acd\u0aaa\u0aa3, \u0ab6\u0acd\u0ab0\u0abe\u0aa7 \u0a85\u0aa8\u0ac7 \u0a86\u0a82\u0aa4\u0ab0\u0abf\u0a95 \u0ab8\u0abe\u0aa7\u0aa8\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a9c \u0ab6\u0acd\u0ab0\u0ac7\u0ab7\u0acd\u0aa0.':s?'\u0935\u094d\u092f\u093e\u092a\u093e\u0930 \u092a\u094d\u0930\u093e\u0930\u0902\u092d, \u0935\u093f\u0935\u093e\u0939, \u092f\u093e\u0924\u094d\u0930\u093e \u092f\u093e \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0905\u0928\u0941\u092c\u0902\u0927 \u0939\u0947\u0924\u0941 \u0905\u0928\u0941\u092f\u0941\u0915\u094d\u0924; \u0915\u0947\u0935\u0932 \u092a\u093f\u0924\u0943 \u0924\u0930\u094d\u092a\u0923, \u0936\u094d\u0930\u093e\u0926\u094d\u0927 \u090f\u0935\u0902 \u0906\u0902\u0924\u0930\u093f\u0915 \u0938\u093e\u0927\u0928\u093e \u0939\u0947\u0924\u0941 \u0909\u092a\u092f\u0941\u0915\u094d\u0924\u0964':h?'Heavy planetary quietude. Avoid starting commercial projects, travel, marriages, or financial contracts; exclusively suited for ancestral worship (Pitr Tarpan) and internal sadhana.':l?'\u0935\u094d\u092f\u093e\u092a\u093e\u0930, \u0935\u093f\u0935\u093e\u0939, \u092a\u094d\u0930\u0935\u093e\u0938 \u0935\u093e \u0915\u0930\u093e\u0930\u093e\u0902\u0938\u093e\u0920\u0940 \u0905\u092f\u094b\u0917\u094d\u092f; \u0915\u0947\u0935\u0933 \u092a\u093f\u0924\u0943 \u0924\u0930\u094d\u092a\u0923, \u0936\u094d\u0930\u093e\u0926\u094d\u0927 \u0935 \u0906\u0902\u0924\u0930\u093f\u0915 \u0938\u093e\u0927\u0928\u0947\u0938\u093e\u0920\u0940 \u092f\u094b\u0917\u094d\u092f.':'Exclusively suited for ancestral worship (Pitr Tarpan) and internal sadhana.'}}}},709,[707]);
