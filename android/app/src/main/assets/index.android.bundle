__d(function(g,_r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.RASHIPHAL_DATA=void 0,e.getRashiById=function(t){return n.find(function(n){return n.id===t.toLowerCase()})||n[0]};var n=e.RASHIPHAL_DATA=[{id:'mesha',name:'Aries (Mesha)',hindiName:'\u092e\u0947\u0937 (Aries)',symbol:'\u2648',element:'Fire (\u0905\u0917\u094d\u0928\u093f)',rulingPlanet:'Mars (Mangal)',dailyPrediction:'A highly energetic day for strategic decision making and leadership initiatives. Mars grants high courage and clarity.',predictionHindi:'\u0906\u091c \u0915\u093e \u0926\u093f\u0928 \u0930\u0923\u0928\u0940\u0924\u093f\u0915 \u0928\u093f\u0930\u094d\u0923\u092f \u0932\u0947\u0928\u0947 \u0914\u0930 \u0928\u0947\u0924\u0943\u0924\u094d\u0935 \u0915\u094d\u0937\u092e\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0905\u0924\u094d\u092f\u0927\u093f\u0915 \u090a\u0930\u094d\u091c\u093e\u0935\u093e\u0928 \u0914\u0930 \u092b\u0932\u0926\u093e\u092f\u0940 \u0939\u0948\u0964',careerPrediction:'\ud83d\udcbc Excellent time for executing pending project launches or pitching new ideas. Senior executives will appreciate your proactive drive.',financePrediction:'\ud83d\udcb0 Financial inflows from past investments are likely. Avoid impulsive speculative trading in late afternoon.',lovePrediction:'\u2764\ufe0f Passionate vibes in relationships. Single Aries may connect with someone inspiring through work or mutual friends.',healthPrediction:'\ud83e\ude7a High physical stamina, but stay hydrated and avoid overexertion during midday hours.',luckyNumber:9,luckyColorName:'Crimson Red (\u0917\u0939\u0930\u093e \u0932\u093e\u0932)',luckyColorHex:'#D32F2F',luckyDirection:'East (\u092a\u0942\u0930\u094d\u0935)',auspiciousTimeWindow:'08:15 AM - 10:30 AM',dailyRemedy:'\ud83c\udf38 Offer red flowers or Hanuman Chalisa recitation to Mangal Dev for smooth obstacle clearance.',compatibility:'Leo, Sagittarius'},{id:'vrishabha',name:'Taurus (Vrishabha)',hindiName:'\u0935\u0943\u0937\u092d (Taurus)',symbol:'\u2649',element:'Earth (\u092a\u0943\u0925\u094d\u0935\u0940)',rulingPlanet:'Venus (Shukra)',dailyPrediction:'Focus on family harmony, creative endeavors, and financial stability. Venus brings charm and aesthetic peace.',predictionHindi:'\u092a\u093e\u0930\u093f\u0935\u093e\u0930\u093f\u0915 \u0938\u094c\u0939\u093e\u0930\u094d\u0926, \u0915\u0932\u093e\u0924\u094d\u092e\u0915 \u0915\u093e\u0930\u094d\u092f\u094b\u0902 \u0914\u0930 \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0938\u094d\u0925\u093f\u0930\u0924\u093e \u092a\u0930 \u0927\u094d\u092f\u093e\u0928 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0915\u0930\u0947\u0902\u0964',careerPrediction:'\ud83d\udcbc Creative and design pursuits receive strong acclaim. Collaboration with colleagues brings rewarding results.',financePrediction:'\ud83d\udcb0 Good day for long-term real estate or fixed wealth planning. Unexpected monetary gifts or returns indicated.',lovePrediction:'\u2764\ufe0f Warm and supportive atmosphere at home. Expressing affection openly will deepen mutual trust.',healthPrediction:'\ud83e\ude7a Mental calm and steady energy. Incorporate light evening walks and wholesome home meals.',luckyNumber:6,luckyColorName:'Amber Gold (\u0938\u0941\u0928\u0939\u0930\u093e \u092a\u0940\u0932\u093e)',luckyColorHex:'#FFB300',luckyDirection:'South-East (\u0926\u0915\u094d\u0937\u093f\u0923-\u092a\u0942\u0930\u094d\u0935)',auspiciousTimeWindow:'10:45 AM - 12:30 PM',dailyRemedy:'\ud83e\ude94 Light a ghee lamp in the evening and recite "Om Shukraya Namah" for prosperity.',compatibility:'Virgo, Capricorn'},{id:'mithuna',name:'Gemini (Mithuna)',hindiName:'\u092e\u093f\u0925\u0941\u0928 (Gemini)',symbol:'\u264a',element:'Air (\u0935\u093e\u092f\u0941)',rulingPlanet:'Mercury (Budha)',dailyPrediction:'Exceptional communication and analytical intellect open new doors in business contracts and media.',predictionHindi:'\u0909\u0924\u094d\u0915\u0943\u0937\u094d\u091f \u0938\u0902\u0935\u093e\u0926 \u0915\u094d\u0937\u092e\u0924\u093e \u0914\u0930 \u092c\u094c\u0926\u094d\u0927\u093f\u0915 \u0915\u094c\u0936\u0932 \u0938\u0947 \u0935\u094d\u092f\u093e\u092a\u093e\u0930 \u0914\u0930 \u0905\u0928\u0941\u092c\u0902\u0927\u094b\u0902 \u092e\u0947\u0902 \u0928\u090f \u0905\u0935\u0938\u0930 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0902\u0917\u0947\u0964',careerPrediction:'\ud83d\udcbc Perfect day for negotiations, writing, coding, and presentations. Your sharp logic wins team support.',financePrediction:'\ud83d\udcb0 Favorable for short-term financial gains and business agreements. Review documents carefully before signing.',lovePrediction:'\u2764\ufe0f Intellectual conversations stimulate deep bond. Great day for joint travel planning.',healthPrediction:'\ud83e\ude7a Mind is active; practice 10 minutes of deep breathing (Pranayama) to prevent mental fatigue.',luckyNumber:5,luckyColorName:'Emerald Green (\u092a\u0928\u094d\u0928\u093e \u0939\u0930\u093e)',luckyColorHex:'#388E3C',luckyDirection:'North (\u0909\u0924\u094d\u0924\u0930)',auspiciousTimeWindow:'02:00 PM - 03:45 PM',dailyRemedy:'\ud83c\udf3f Feed green grass (Durva) to cows or offer green gram (Moong) to honor Lord Budha.',compatibility:'Libra, Aquarius'},{id:'karka',name:'Cancer (Karka)',hindiName:'\u0915\u0930\u094d\u0915 (Cancer)',symbol:'\u264b',element:'Water (\u091c\u0932)',rulingPlanet:'Moon (Chandra)',dailyPrediction:'Emotional intuition is heightened. Trust your inner voice in personal and financial matters.',predictionHindi:'\u092d\u093e\u0935\u0928\u093e\u0924\u094d\u092e\u0915 \u0905\u0902\u0924\u0930\u094d\u0926\u0943\u0937\u094d\u091f\u093f \u092e\u091c\u092c\u0942\u0924 \u0930\u0939\u0947\u0917\u0940\u0964 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0914\u0930 \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u092e\u093e\u092e\u0932\u094b\u0902 \u092e\u0947\u0902 \u0905\u0902\u0924\u0930\u093e\u0924\u094d\u092e\u093e \u0915\u0940 \u0906\u0935\u093e\u091c \u092a\u0930 \u092d\u0930\u094b\u0938\u093e \u0915\u0930\u0947\u0902\u0964',careerPrediction:'\ud83d\udcbc Empathetic leadership boosts team morale. Focus on completing ongoing responsibilities with care.',financePrediction:'\ud83d\udcb0 Stable financial growth. Savings strategies implemented today yield long-term peace of mind.',lovePrediction:'\u2764\ufe0f Deep emotional intimacy and understanding with your partner. Family blessings bring joy.',healthPrediction:'\ud83e\ude7a Hydration and restful sleep are essential. Evening meditation brings deep rejuvenation.',luckyNumber:2,luckyColorName:'Pearl White (\u092e\u094b\u0924\u0940 \u0938\u092b\u0947\u0926)',luckyColorHex:'#F5F5F5',luckyDirection:'North-West (\u0909\u0924\u094d\u0924\u0930-\u092a\u0936\u094d\u091a\u093f\u092e)',auspiciousTimeWindow:'07:00 AM - 08:45 AM',dailyRemedy:'\ud83e\udd5b Offer milk or Arghya to the Moon at night for emotional peace and mental strength.',compatibility:'Scorpio, Pisces'},{id:'simha',name:'Leo (Simha)',hindiName:'\u0938\u093f\u0902\u0939 (Leo)',symbol:'\u264c',element:'Fire (\u0905\u0917\u094d\u0928\u093f)',rulingPlanet:'Sun (Surya)',dailyPrediction:'Radiant confidence and natural authority attract recognition and success in high-visibility tasks.',predictionHindi:'\u0906\u0924\u094d\u092e\u0935\u093f\u0936\u094d\u0935\u093e\u0938 \u0914\u0930 \u092a\u094d\u0930\u092d\u093e\u0935 \u092e\u0947\u0902 \u0935\u0943\u0926\u094d\u0927\u093f \u0939\u094b\u0917\u0940\u0964 \u092e\u0939\u0924\u094d\u0935\u092a\u0942\u0930\u094d\u0923 \u0915\u093e\u0930\u094d\u092f\u094b\u0902 \u092e\u0947\u0902 \u0938\u092b\u0932\u0924\u093e \u0914\u0930 \u0938\u092e\u094d\u092e\u093e\u0928 \u092e\u093f\u0932\u0947\u0917\u093e\u0964',careerPrediction:'\ud83d\udcbc Public speaking, executive meetings, and leadership roles go exceptionally well today.',financePrediction:'\ud83d\udcb0 Financial reputation improves. Wise reinvestment in growth assets brings strong future gains.',lovePrediction:'\u2764\ufe0f Generous and joyful energy in romance. Celebrating milestones together enhances bond.',healthPrediction:'\ud83e\ude7a High vitality and enthusiasm. Maintain good posture and absorb morning sunlight.',luckyNumber:1,luckyColorName:'Royal Saffron (\u0915\u0947\u0938\u0930\u093f\u092f\u093e \u0928\u093e\u0930\u0902\u0917\u0940)',luckyColorHex:'#E65100',luckyDirection:'East (\u092a\u0942\u0930\u094d\u0935)',auspiciousTimeWindow:'06:30 AM - 08:15 AM',dailyRemedy:'\ud83c\udf05 Offer water (Surya Arghya) with red kumkum to the rising Sun for health and fame.',compatibility:'Aries, Sagittarius'},{id:'virgo',name:'Virgo (Kanya)',hindiName:'\u0915\u0928\u094d\u092f\u093e (Virgo)',symbol:'\u264d',element:'Earth (\u092a\u0943\u0925\u094d\u0935\u0940)',rulingPlanet:'Mercury (Budha)',dailyPrediction:'Meticulous attention to detail and practical organization solve complex problems effortlessly.',predictionHindi:'\u092c\u093e\u0930\u0940\u0915\u093f\u092f\u094b\u0902 \u092a\u0930 \u0927\u094d\u092f\u093e\u0928 \u0926\u0947\u0928\u0947 \u0914\u0930 \u0935\u094d\u092f\u093e\u0935\u0939\u093e\u0930\u093f\u0915 \u0938\u0902\u0917\u0920\u0928 \u0938\u0947 \u0915\u0920\u093f\u0928 \u0938\u092e\u0938\u094d\u092f\u093e\u090f\u0902 \u0906\u0938\u093e\u0928\u0940 \u0938\u0947 \u0939\u0932 \u0939\u094b\u0902\u0917\u0940\u0964',careerPrediction:'\ud83d\udcbc Ideal day for auditing, coding, database management, and refining operational workflows.',financePrediction:'\ud83d\udcb0 Excellent financial management. Budgeting and cost reduction steps succeed remarkably.',lovePrediction:'\u2764\ufe0f Practical acts of service and helpful gestures communicate care more than grand words.',healthPrediction:'\ud83e\ude7a Digestive health is good; stick to fresh, home-cooked organic meals and herbal tea.',luckyNumber:5,luckyColorName:'Jade Green (\u091c\u0948\u0921 \u0939\u0930\u093e)',luckyColorHex:'#2E7D32',luckyDirection:'North (\u0909\u0924\u094d\u0924\u0930)',auspiciousTimeWindow:'11:15 AM - 01:00 PM',dailyRemedy:'\ud83d\udcd6 Recite Vishnu Sahasranama or chant "Om Namo Bhagavate Vasudevaya" for mental clarity.',compatibility:'Taurus, Capricorn'},{id:'tula',name:'Libra (Tula)',hindiName:'\u0924\u0941\u0932\u093e (Libra)',symbol:'\u264e',element:'Air (\u0935\u093e\u092f\u0941)',rulingPlanet:'Venus (Shukra)',dailyPrediction:'Harmonious social connections and diplomatic tact bring win-win solutions in all endeavors.',predictionHindi:'\u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0938\u0902\u092c\u0902\u0927\u094b\u0902 \u0914\u0930 \u0915\u0942\u091f\u0928\u0940\u0924\u093f\u0915 \u0926\u0943\u0937\u094d\u091f\u093f\u0915\u094b\u0923 \u0938\u0947 \u091c\u0940\u0935\u0928 \u092e\u0947\u0902 \u0938\u0902\u0924\u0941\u0932\u0928 \u0914\u0930 \u0938\u092b\u0932\u0924\u093e \u092e\u093f\u0932\u0947\u0917\u0940\u0964',careerPrediction:'\ud83d\udcbc Client meetings, partnerships, and artistic collaborations flourish. Conflict resolution succeeds.',financePrediction:'\ud83d\udcb0 Good financial balance. Balanced investments between growth and security recommended.',lovePrediction:'\u2764\ufe0f Romantic harmony and sweet mutual appreciation. A perfect evening for a dinner date.',healthPrediction:'\ud83e\ude7a Balanced energy; light yoga, stretching, or dance keeps flexibility and mood elevated.',luckyNumber:7,luckyColorName:'Sky Blue (\u0906\u0915\u093e\u0936\u0940\u092f \u0928\u0940\u0932\u093e)',luckyColorHex:'#0288D1',luckyDirection:'West (\u092a\u0936\u094d\u091a\u093f\u092e)',auspiciousTimeWindow:'03:30 PM - 05:15 PM',dailyRemedy:'\ud83c\udf38 Donate white sweets or fragrance in a temple for Venusian harmony and prosperity.',compatibility:'Gemini, Aquarius'},{id:'vrischika',name:'Scorpio (Vrischika)',hindiName:'\u0935\u0943\u0936\u094d\u091a\u093f\u0915 (Scorpio)',symbol:'\u264f',element:'Water (\u091c\u0932)',rulingPlanet:'Mars & Ketu',dailyPrediction:'Deep research, transformative insight, and unwavering determination unlock hidden opportunities.',predictionHindi:'\u0917\u0939\u0928 \u0936\u094b\u0927, \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928\u0915\u093e\u0930\u0940 \u0905\u0902\u0924\u0930\u094d\u0926\u0943\u0937\u094d\u091f\u093f \u0914\u0930 \u0905\u091f\u0942\u091f \u0938\u0902\u0915\u0932\u094d\u092a \u0938\u0947 \u091b\u0941\u092a\u0947 \u0905\u0935\u0938\u0930 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0939\u094b\u0902\u0917\u0947\u0964',careerPrediction:'\ud83d\udcbc Strategic investigation, technical problem-solving, and confidential tasks succeed brilliantly.',financePrediction:'\ud83d\udcb0 Potential gains from insurance, legacy assets, or unearned wealth. Avoid risky lending.',lovePrediction:'\u2764\ufe0f Intense and loyal romantic connection. Honesty and emotional vulnerability deepen trust.',healthPrediction:'\ud83e\ude7a Detoxification practices and plenty of clean water intake support physical stamina.',luckyNumber:9,luckyColorName:'Maroon Red (\u0917\u0939\u0930\u093e \u092e\u0948\u0930\u0942\u0928)',luckyColorHex:'#800000',luckyDirection:'South (\u0926\u0915\u094d\u0937\u093f\u0923)',auspiciousTimeWindow:'01:30 PM - 03:00 PM',dailyRemedy:'\ud83e\ude94 Light a mustard oil lamp for Lord Hanuman to overcome subtle obstacles.',compatibility:'Cancer, Pisces'},{id:'dhanu',name:'Sagittarius (Dhanu)',hindiName:'\u0927\u0928\u0941 (Sagittarius)',symbol:'\ud83c\udff9',element:'Fire (\u0905\u0917\u094d\u0928\u093f)',rulingPlanet:'Jupiter (Guru)',dailyPrediction:'Optimism, higher learning, and philosophical wisdom guide successful long-term expansion.',predictionHindi:'\u0938\u0915\u093e\u0930\u093e\u0924\u094d\u092e\u0915\u0924\u093e, \u0909\u091a\u094d\u091a \u0936\u093f\u0915\u094d\u0937\u093e \u0914\u0930 \u091c\u094d\u091e\u093e\u0928 \u0938\u0947 \u0926\u0940\u0930\u094d\u0918\u0915\u093e\u0932\u093f\u0915 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u092e\u0947\u0902 \u092c\u0921\u093c\u0940 \u0938\u092b\u0932\u0924\u093e \u092e\u093f\u0932\u0947\u0917\u0940\u0964',careerPrediction:'\ud83d\udcbc Ideal for teaching, publishing, international business, and strategic expansion planning.',financePrediction:'\ud83d\udcb0 Prosperity through wisdom and ethical investments. Charitable acts attract cosmic abundance.',lovePrediction:'\u2764\ufe0f Inspiring conversations with partner about future goals and spiritual travel.',healthPrediction:'\ud83e\ude7a Excellent mental vitality. Outdoor activities, hiking, or sports refresh body and spirit.',luckyNumber:3,luckyColorName:'Bright Yellow (\u092a\u0940\u0932\u093e)',luckyColorHex:'#FBC02D',luckyDirection:'North-East (\u0908\u0936\u093e\u0928 \u0915\u094b\u0923)',auspiciousTimeWindow:'09:00 AM - 10:45 AM',dailyRemedy:'\ud83d\udc9b Apply turmeric/sandalwood tilak on forehead and honor elders or spiritual teachers.',compatibility:'Aries, Leo'},{id:'makara',name:'Capricorn (Makara)',hindiName:'\u092e\u0915\u0930 (Capricorn)',symbol:'\u2651',element:'Earth (\u092a\u0943\u0925\u094d\u0935\u0940)',rulingPlanet:'Saturn (Shani)',dailyPrediction:'Disciplined perseverance, practical realism, and structure lead to enduring professional victory.',predictionHindi:'\u0905\u0928\u0941\u0936\u093e\u0938\u0928, \u0935\u094d\u092f\u093e\u0935\u0939\u093e\u0930\u093f\u0915 \u0926\u0943\u0937\u094d\u091f\u093f\u0915\u094b\u0923 \u0914\u0930 \u0932\u0917\u0928 \u0938\u0947 \u0938\u094d\u0925\u093e\u092f\u0940 \u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u0938\u092b\u0932\u0924\u093e \u092e\u093f\u0932\u0947\u0917\u0940\u0964',careerPrediction:'\ud83d\udcbc Senior management and long-term milestone execution are favored. Persistence pays off.',financePrediction:'\ud83d\udcb0 Solid wealth accumulation. Sound financial discipline guarantees steady capital growth.',lovePrediction:'\u2764\ufe0f Reliable and committed presence strengthens relationships. Action speaks louder than words.',healthPrediction:'\ud83e\ude7a Joint mobility and bone health; gentle stretches and magnesium-rich diet recommended.',luckyNumber:8,luckyColorName:'Navy Blue (\u0917\u0939\u0930\u093e \u0928\u0940\u0932\u093e)',luckyColorHex:'#1565C0',luckyDirection:'West (\u092a\u0936\u094d\u091a\u093f\u092e)',auspiciousTimeWindow:'04:15 PM - 06:00 PM',dailyRemedy:'\ud83d\udda4 Light a sesame oil lamp under a Peepal tree or donate black sesame to honor Shani Dev.',compatibility:'Taurus, Virgo'},{id:'kumbha',name:'Aquarius (Kumbha)',hindiName:'\u0915\u0941\u0902\u092d (Aquarius)',symbol:'\u2652',element:'Air (\u0935\u093e\u092f\u0941)',rulingPlanet:'Saturn & Rahu',dailyPrediction:'Innovative thinking, community networking, and humanitarian ideals spark revolutionary success.',predictionHindi:'\u0928\u0935\u093e\u091a\u093e\u0930, \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u0914\u0930 \u092e\u093e\u0928\u0935\u0940\u092f \u0935\u093f\u091a\u093e\u0930\u094b\u0902 \u0938\u0947 \u0915\u094d\u0930\u093e\u0902\u0924\u093f\u0915\u093e\u0930\u0940 \u0914\u0930 \u0924\u0915\u0928\u0940\u0915\u0940 \u0938\u092b\u0932\u0924\u093e \u092e\u093f\u0932\u0947\u0917\u0940\u0964',careerPrediction:'\ud83d\udcbc Technology, social causes, group projects, and futuristic planning receive high momentum.',financePrediction:'\ud83d\udcb0 Financial gains through group ventures, tech investments, or social networks.',lovePrediction:'\u2764\ufe0f Open-minded companionship and shared intellectual vision strengthen emotional connection.',healthPrediction:'\ud83e\ude7a Ankle and circulatory health; take short breaks during computer work to walk around.',luckyNumber:11,luckyColorName:'Electric Cyan (\u0928\u0940\u0932\u093e/\u0906\u0915\u093e\u0936\u0940\u092f)',luckyColorHex:'#00ACC1',luckyDirection:'West (\u092a\u0936\u094d\u091a\u093f\u092e)',auspiciousTimeWindow:'01:00 PM - 02:45 PM',dailyRemedy:'\ud83e\ude94 Feed street dogs or help underprivileged workers to gain Rahu & Saturn blessings.',compatibility:'Gemini, Libra'},{id:'meena',name:'Pisces (Meena)',hindiName:'\u092e\u0940\u0928 (Pisces)',symbol:'\u2653',element:'Water (\u091c\u0932)',rulingPlanet:'Jupiter (Guru)',dailyPrediction:'Spiritual devotion, creative imagination, and compassionate wisdom bring serene inner fulfillment.',predictionHindi:'\u0906\u0927\u094d\u092f\u093e\u0924\u094d\u092e\u093f\u0915 \u092d\u0915\u094d\u0924\u093f, \u0930\u091a\u0928\u093e\u0924\u094d\u092e\u0915 \u0915\u0932\u094d\u092a\u0928\u093e \u0914\u0930 \u0915\u0930\u0941\u0923\u093e \u0938\u0947 \u0906\u0924\u094d\u092e\u093f\u0915 \u0936\u093e\u0902\u0924\u093f \u0914\u0930 \u0938\u093f\u0926\u094d\u0927\u093f \u092e\u093f\u0932\u0947\u0917\u0940\u0964',careerPrediction:'\ud83d\udcbc Creative arts, healing, psychology, and spiritual endeavors yield profound recognition.',financePrediction:'\ud83d\udcb0 Intuitive financial choices work well. Donating a small portion to charity enhances luck.',lovePrediction:'\u2764\ufe0f Unconditional love, spiritual empathy, and soul-level connection with your life partner.',healthPrediction:'\ud83e\ude7a Peaceful nervous system; ocean sounds, gentle music, and warm baths recharge energy.',luckyNumber:3,luckyColorName:'Ocean Violet (\u0938\u092e\u0941\u0926\u094d\u0930\u0940 \u092c\u0948\u0902\u0917\u0928\u0940)',luckyColorHex:'#7B1FA2',luckyDirection:'North-East (\u0908\u0936\u093e\u0928 \u0915\u094b\u0923)',auspiciousTimeWindow:'08:00 AM - 09:45 AM',dailyRemedy:'\ud83d\udc9b Chant "Om Gram Greem Grom Sah Gurave Namah" and offer yellow gram to temple.',compatibility:'Cancer, Scorpio'}]},864,[]);
