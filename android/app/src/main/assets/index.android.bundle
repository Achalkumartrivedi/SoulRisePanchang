u092f: \u0936\u0928\u093f \u092d\u093e\u0935 ${h} (1 \u0938\u0947 7 \u0915\u0947 \u092e\u0927\u094d\u092f) \u092e\u0947\u0902 \u0938\u094d\u0925\u093f\u0924 \u0939\u0948 \u0914\u0930 10\u0935\u093e\u0902 \u092d\u093e\u0935 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0916\u093e\u0932\u0940 \u0939\u0948! \u0932\u093e\u0932 \u0915\u093f\u0924\u093e\u092c \u0928\u093f\u092f\u092e: \u0936\u0928\u093f \u0915\u094b \u0905\u092a\u094d\u0930\u0924\u094d\u092f\u093e\u0936\u093f\u0924 \u0938\u0940\u0927\u093e \u0938\u0939\u092f\u094b\u0917 \u092e\u093f\u0932\u0924\u093e \u0939\u0948 \u0914\u0930 \u0915\u0930\u093f\u092f\u0930 \u092e\u0947\u0902 \u0905\u091a\u093e\u0928\u0915 \u0909\u091b\u093e\u0932 \u0906\u0924\u093e \u0939\u0948!`:L?`\u2139\ufe0f 10\u0935\u093e\u0902 \u092d\u093e\u0935 \u0916\u093e\u0932\u0940 \u0939\u0948, \u092a\u0930\u0902\u0924\u0941 \u0936\u0928\u093f \u092d\u093e\u0935 ${h} \u092e\u0947\u0902 \u0939\u0948\u0964`:`\u2139\ufe0f 10\u0935\u0947\u0902 \u092d\u093e\u0935 \u092e\u0947\u0902 ${R.map(function(n){return n.name.split(' ')[0]}).join(', ')} \u0938\u094d\u0925\u093f\u0924 \u0939\u0948\u0902\u0964`,gu:M?"\u2705 \u0ab8\u0a95\u0acd\u0ab0\u0abf\u0aaf: \u0ab6\u0aa8\u0abf \u0ae7-\u0aed \u0aad\u0abe\u0ab5\u0aae\u0abe\u0a82 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0ae7\u0ae6\u0aae\u0acb \u0aad\u0abe\u0ab5 \u0a96\u0abe\u0ab2\u0ac0 \u0a9b\u0ac7. \u0a85\u0a9a\u0abe\u0aa8\u0a95 \u0aae\u0acb\u0a9f\u0ac0 \u0a95\u0abe\u0ab0\u0a95\u0abf\u0ab0\u0acd\u0aa6\u0ac0 \u0ab8\u0aab\u0ab3\u0aa4\u0abe \u0aae\u0ab3\u0ac7 \u0a9b\u0ac7!":"\u2139\ufe0f \u0ae7\u0ae6\u0aae\u0acb \u0aad\u0abe\u0ab5 \u0aad\u0ab0\u0ac7\u0ab2\u0acb \u0a9b\u0ac7."}});var D=f.Mars||f.Mangala,I=f.Mercury||f.Budha,k=D&&I&&D.house===I.house;v.push({ruleId:'mars_mercury_imitation',ruleName:{en:'5. Mars + Mercury Conjunction Rare Rule',hi:'5. \u092e\u0902\u0917\u0932 + \u092c\u0941\u0927 \u0926\u0941\u0930\u094d\u0932\u092d \u092f\u0941\u0924\u093f \u0928\u093f\u092f\u092e (Mars + Mercury Combination)',gu:'\u0aeb. \u0aae\u0a82\u0a97\u0ab3 + \u0aac\u0ac1\u0aa7 \u0aaf\u0ac1\u0aa4\u0abf \u0aa8\u0abf\u0aaf\u0aae'},isTriggered:k,description:{en:k?`\ud83d\udc8e RARE LAL KITAB SECRET TRIGGERED: Mars and Mercury sit together in House ${null==D?void 0:D.house}! They imitate Saturn's behavior, while Saturn in House ${h} behaves more like Rahu (sudden tech surges & foreign MNC platforms)!`:`\u2139\ufe0f Mars (House ${null==D?void 0:D.house}) and Mercury (House ${null==I?void 0:I.house}) are in different houses. Saturn operates as Karma Karaka.`,hi:k?`\ud83d\udc8e \u0905\u0924\u094d\u092f\u0902\u0924 \u0926\u0941\u0930\u094d\u0932\u092d \u0932\u093e\u0932 \u0915\u093f\u0924\u093e\u092c \u0930\u0939\u0938\u094d\u092f \u0938\u0915\u094d\u0930\u093f\u092f: \u092e\u0902\u0917\u0932 \u0935 \u092c\u0941\u0927 \u092d\u093e\u0935 ${null==D?void 0:D.house} \u092e\u0947\u0902 \u090f\u0915 \u0938\u093e\u0925 \u092c\u0948\u0920\u0947 \u0939\u0948\u0902! \u0935\u0947 \u0936\u0928\u093f \u0915\u0940 \u0924\u0930\u0939 \u0935\u094d\u092f\u0935\u0939\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u091c\u092c\u0915\u093f \u0906\u092a\u0915\u093e \u0936\u0928\u093f (\u092d\u093e\u0935 ${h}) \u0930\u093e\u0939\u0941 \u0915\u0940 \u092d\u093e\u0902\u0924\u093f \u0905\u092a\u094d\u0930\u0924\u094d\u092f\u093e\u0936\u093f\u0924 \u092c\u0921\u093c\u0940 \u091b\u0932\u093e\u0902\u0917 \u0935 \u0935\u0948\u0926\u0947\u0936\u093f\u0915 IT \u0905\u0935\u0938\u0930 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948!`:"\u2139\ufe0f \u092e\u0902\u0917\u0932 \u0935 \u092c\u0941\u0927 \u0905\u0932\u0917-\u0905\u0932\u0917 \u092d\u093e\u0935\u094b\u0902 \u092e\u0947\u0902 \u0939\u0948\u0902\u0964",gu:k?"\ud83d\udc8e \u0aa6\u0ac1\u0ab0\u0acd\u0ab2\u0aad \u0ab2\u0abe\u0ab2 \u0a95\u0abf\u0aa4\u0abe\u0aac \u0ab0\u0ab9\u0ab8\u0acd\u0aaf \u0ab8\u0a95\u0acd\u0ab0\u0abf\u0aaf! \u0aae\u0a82\u0a97\u0ab3+\u0aac\u0ac1\u0aa7 \u0ab6\u0aa8\u0abf\u0aa8\u0ac1\u0a82 \u0aab\u0ab3 \u0a86\u0aaa\u0ac7 \u0a