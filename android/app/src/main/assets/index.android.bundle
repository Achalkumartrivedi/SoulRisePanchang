0aa4\u0abf\u0ab7\u0ab6\u0abe\u0ab8\u0acd\u0aa4\u0acd\u0ab0\u0aa8\u0ac1\u0a82 \u0a8f\u0a95 \u0ab5\u0abf\u0ab6\u0ac7\u0ab7 \u0a97\u0acb\u0a9a\u0ab0 \u0a9a\u0abe\u0ab0\u0acd\u0a9f \u0a9b\u0ac7 \u0a9c\u0ac7 \u0ae8\u0aed/\u0ae8\u0aee \u0aa8\u0a95\u0acd\u0ab7\u0aa4\u0acd\u0ab0\u0acb\u0aa8\u0ac7 \u0a95\u0abf\u0ab2\u0acd\u0ab2\u0abe\u0aa8\u0abe \u0aea \u0ab8\u0aae\u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0\u0abf\u0aa4 \u0ab5\u0ab2\u0aaf\u0acb\u0aae\u0abe\u0a82 \u0a97\u0acb\u0aa0\u0ab5\u0ac7 \u0a9b\u0ac7: \u0ab8\u0acd\u0aa4\u0a82\u0aad (\u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0), \u0aa6\u0ac1\u0ab0\u0acd\u0a97\u0abe\u0a82\u0aa4\u0ab0 (\u0a86\u0a82\u0aa4\u0ab0\u0abf\u0a95), \u0aaa\u0acd\u0ab0\u0abe\u0a95\u0abe\u0ab0 (\u0aa6\u0ac0\u0ab5\u0abe\u0ab2) \u0a85\u0aa8\u0ac7 \u0aac\u0abe\u0ab9\u0acd\u0aaf (\u0aac\u0ab9\u0abe\u0ab0\u0aa8\u0acb \u0ab5\u0abf\u0ab8\u0acd\u0aa4\u0abe\u0ab0).','\u0915\u094b\u091f\u093e \u091a\u0915\u094d\u0930 \u0935\u0948\u0926\u093f\u0915 \u091c\u094d\u092f\u094b\u0924\u093f\u0937 \u0915\u093e \u090f\u0915 \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u0917\u094b\u091a\u0930 \u091a\u093e\u0930\u094d\u091f \u0939\u0948 \u091c\u094b \u0968\u096d/\u0968\u096e \u0928\u0915\u094d\u0937\u0924\u094d\u0930\u094b\u0902 \u0915\u094b \u0926\u0941\u0930\u094d\u0917 \u0915\u0940 \u096a \u0938\u0902\u0915\u0947\u0902\u0926\u094d\u0930\u0940 \u092a\u0930\u0924\u094b\u0902 \u092e\u0947\u0902 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948: \u0938\u094d\u0924\u0902\u092d (\u0915\u0947\u0902\u0926\u094d\u0930), \u0926\u0941\u0930\u094d\u0917\u093e\u0902\u0924\u0930 (\u0906\u0902\u0924\u0930\u093f\u0915), \u092a\u094d\u0930\u093e\u0915\u093e\u0930 (\u0926\u0940\u0935\u093e\u0930) \u0914\u0930 \u092c\u093e\u0939\u094d\u092f (\u092c\u093e\u0939\u0930\u0940 \u0915\u094d\u0937\u0947\u0924\u094d\u0930)\u0964','Kota Chakra is a specialized Vedic astrology transit chart overlay that arranges lunar nakshatras into four concentric fort layers: Stambha (Center Core), Durgantara (Inner Fort), Prakara (Outer Wall), and Bahya (Outside Territory).')})]}),(0,l.jsxs)(n.View,{style:c.sectionCard,children:[(0,l.jsxs)(n.Text,{style:c.sectionTitle,children:["\ud83c\udfaf 2. ",b('\u0a95\u0acb\u0a9f\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 \u0a85\u0aa8\u0ac7 \u0a9c\u0aa8\u0acd\u0aae \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 (Kendras) \u0ab5\u0a9a\u0acd\u0a9a\u0ac7\u0aa8\u0acb \u0aa4\u0aab\u0abe\u0ab5\u0aa4','\u0915\u094b\u091f\u093e \u0915\u0947\u0902\u0926\u094d\u0930 \u090f\u0935\u0902 \u091c\u0928\u094d\u092e \u0915\u0947\u0902\u0926\u094d\u0930 (Kendras) \u092e\u0947\u0902 \u0905\u0902\u0924\u0930','Kota Center vs Natal Kendras')]}),(0,l.jsx)(n.Text,{style:c.paragraph,children:b('\u2022 \u0a95\u0acb\u0a9f\u0abe \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 (\u0ab8\u0acd\u0aa4\u0a82\u0aad): \u0a9c\u0aa8\u0acd\u0aae \u0aa8\u0a95\u0acd\u0ab7\u0aa4\u0acd\u0ab0 \u0aaa\u0ab0 \u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0a97\u0acb\u0a9a\u0ab0 \u0a86\u0aa7\u0abe\u0ab0\u0abf\u0aa4 \u0a86\u0a82\u0aa4\u0ab0\u0abf\u0a95 \u0a95\u0abf\u0ab2\u0acd\u0ab2\u0acb \u0a9b\u0ac7.\n\u2022 \u0a9c\u0aa8\u0acd\u0aae \u0a95\u0ac1\u0a82\u0aa1\u0ab3\u0ac0 \u0a95\u0ac7\u0aa8\u0acd\u0aa6\u0acd\u0ab0 (\u0ae7-\u0aea-\u0aed-\u0ae7\u0ae6 \u0aad\u0abe\u0ab5): \u0ab2\u0a97\u0acd\u0aa8 \u0a95\u0ac1\u0a82\u0aa1\u0ab3\u0ac0 \u0a85\u0aa8\u0ac7 \u0aa8\u0ab5\u0aae\u0abe\u0a82\u0ab6\u0aa8\u0abe \u0ab8\u0acd\u0aa5\u0abe\u0aaf\u0ac0 \u0ab8\u0acd\u0aa4\u0a82\u0aad \u0a9b\u0ac7.\n\u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0a95\u0acd\u0ab0\u0ac2\u0ab0 \u0a97\u0acd\u0ab0\u0ab9\u0acb \u0a95\u0acb\u0a9f\u0abe \u0a9a\u0a95\u0acd\u0ab0\u0aa8\u0abe \u0ab8\u0acd\u0aa4\u0a82\u0aad\u0aae\u0abe\u0a82 \u0aaa\u0acd\u0ab0\u0ab5\u0ac7\u0ab6 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7 \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aa4\u0ac7 \u0a86\u0a95\u0ab8\u0acd\u0aae\u0abf\u0a95 \u0a95\u0a9f\u0acb\u0a95\u0a9f\u0ac0 \u0a85\u0aa8\u0ac7 \u0ab8\u0a82\u0a95\u0a9f\u0aa8\u0ac1\u0a82 \u0a95\u0abe\u0ab0\u0aa3 \u0aac\u0aa8\u0ac7 \u0a9b\u0ac7.','\u2022 \u0915\u094b\u091f\u093e \u0915\u0947\u0902\u0926\u094d\u0930 (\u0938\u094d\u0924\u0902\u092d): \u091a\u0902\u0926\u094d\u0930 \u091c\u0928\u094d\u092e \u0928\u0915\u094d\u0937\u0924\u094d\u0930 \u092a\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0917\u094b\u091a\u0930 \u091a\u0915\u094d\u0930 \u0915\u093e \u0939\u0943\u0926\u092f \u0939\u0948\u0964\n\u2022 \u091c\u0928\u094d\u092e \u0915\u0941\u0902\u0921\u0932\u0940 \u0915\u0947\u0902\u0926\u094d\u0930 (\u0967-\u096a-\u096d-\u0967\u0966 \u092d\u093e\u0935): \u0915\u0941\u0902\u0921\u0932\u0940 \u0914\u0930 \u0928\u0935\u092e\u093e\u0902\u0936 \u0915\u0947 \u0938\u094d\u0925\u093e\u092f\u0940 \u0938\u094d\u0924\u0902\u092d \u0939\u0948\u0902\u0964\n\u091c\u092c \u0915\u094d\u0930\u0942\u0930 \u0917\u094d\u0930\u0939 \u0938\u094d\u0924\u0902\u092d \u092e\u0947\u0902 \u092a\u094d\u0930\u0935\u0947\u0936 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u092f\u0939 \u0905\u091a\u093e\u0928\u0915 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u092f\u093e \u0915\u0930\u093f\u092f\u0930 \u0938\u0902\u0915\u091f \u092a\u0948\u0926\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964','\u2022 Kota Center (Stambha): Dynamic transit core centered around your Moon Janma Nakshatra.\n\u2022 Natal Kendras (1st, 4th, 7th, 10th houses): Fixed structural pillars of Rasi and Navamsha charts.\nWhen malefic transits invade Stambha, they trigger sudden vulnerability regardless of general natal strength.')})]}),(0,l.jsxs)(n.View,{style:c.sectionCard,children:[(0,l.jsxs)(n.Text,{style:c.sectionTitle,children:["\ud83d\udee1\ufe0f 3. ",b('\u0a95\u0acd\u0ab0\u0ac2\u0ab0 \u0a97\u0acd\u0ab0\u0ab9\u0acb \u0a85\u0aa8\u0ac7 \u0ab6\u0ac1\u0aad \u0a97\u0acd\u0ab0\u0ab9\u0acb\u0aa8\u0acb \u0aaa\u0acd\u0ab0\u0aad\u0abe\u0ab5','\u0915\u094d\u0930\u0942\u0930 \u0917\u094d\u0930\u0939 \u090f\u0935\u0902 \u0936\u0941\u092d \u0917\u094d\u0930\u0939\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u092d\u093e\u0935','Malefics vs Benefics in Kota')]}),(0,l.jsxs)(n.View,{style:c.bulletBox,children:[(0,l.jsxs)(n.Text,{style:c.bulletTitle,children:["\ud83d\udd34 ",b('\u0a95\u0acd\u0ab0\u0ac2\u0ab0 \u0a97\u0acd\u0ab0\u0ab9\u0acb (Malefics)','\u0915\u094d\u0930\u0942\u0930 \u0917\u094d\u0930\u0939 (Malefics)','Malefic Planets'),":"]}),(0,l.jsx)(n.Text,{style:c.bulletText,children:b('\u0ab6\u0aa8\u0abf, \u0aae\u0a82\u0a97\u0ab3, \u0ab0\u0abe\u0ab9\u0ac1, \u0a95\u0ac7\u0aa4\u0ac1, \u0ab8\u0ac2\u0ab0\u0acd\u0aaf \u0a85\u0aa8\u0ac7 \u0aec, \u0aee, \u0ae7\u0ae8 \u0a98\u0ab0\u0aa8\u0abe \u0ab8\u0acd\u0ab5\u0abe\u0aae\u0ac0 (\u0aab\u0a82\u0a95\u0acd\u0ab6\u0aa8\u0ab2 \u0aae\u0ac7\u0ab2\u0ac7\u0aab\u0abf\u0a95). \u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0a86 \u0a97\u0acd\u0ab0\u0ab9\u0acb \u0ab8\u0acd\u0aa4\u0a82\u0aad/\u0aa6\u0ac1\u0ab0\u0acd\u0a97\u0abe\u0a82\u0aa4\u0ab0\u0aae\u0abe\u0a82 \u0aaa\u0acd\u0ab0\u0ab5\u0ac7\u0ab6\u0ac7 \u0a9b\u0ac7 (Pravesha), \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0ab0\u0acb\u0a97, \u0a85\u0a95\u0ab8\u0acd\u0aae\u0abe\u0aa4, \u0ab5\u0abf\u0ab5\u0abe\u0aa6 \u0a95\u0ac7 \u0aa8\u0abe\u0aa3\u0abe\u0a95\u0ac0\u0aaf \u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8 \u0a86\u0aaa\u0ac7 \u0a9b\u0ac7. \u0ab5\u0a95\u0acd\u0ab0\u0ac0 (Retrograde) \u0a97\u0acd\u0ab0\u0ab9 \u0a95\u0abf\u0ab2\u0acd\u0ab2\u0abe\u0aae\u0abe\u0a82 \u0ab2\u0abe\u0a82\u0aac\u0acb \u0ab8\u0aae\u0aaf \u0ab0\u0acb\u0a95\u0abe\u0a88\u0aa8\u0ac7 \u0ab5\u0aa7\u0ac1 \u0ab8\u0a82\u0a95\u0a9f \u0a8a\u0aad\u0ac1\u0a82 \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7.','\u0936\u0928\u093f, \u092e\u0902\u0917\u0932, \u0930\u093e\u0939\u0941, \u0915\u0947\u0924\u0941, \u0938\u0942\u0930\u094d\u092f \u090f\u0935\u0902 \u096c, \u096e, \u0967\u0968\u0935\u0947\u0902 \u0918\u0930 \u0915\u0947 \u0938\u094d\u0935\u093e\u092e\u0940\u0964 \u091c\u092c \u092f\u0947 \u0938\u094d\u0924\u0902\u092d/\u0926\u0941\u0930\u094d\u0917\u093e\u0902\u0924\u0930 \u092e\u0947\u0902 \u092a\u094d\u0930\u0935\u0947\u0936 (Pravesha) \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u092c\u0940\u092e\u093e\u0930\u0940, \u0926\u0941\u0930\u094d\u0918\u091f\u0928\u093e, \u092e\u0941\u0915\u0926\u092e\u0947\u092c\u093e\u091c\u0940 \u092f\u093e \u0935\u094d\u092f\u093e\u092a\u093e\u0930 \u0939\u093e\u0928\u093f \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0935\u0915\u094d\u0930\u0940 \u0917\u094d\u0930\u0939 \u0932\u0902\u092c\u0947 \u0938\u092e\u092f \u0924\u0915 \u0930\u0941\u0915\u0915\u0930 \u0938\u0902\u0915\u091f \u092c\u0922\u093c\u093e\u0924\u093e \u0939\u0948\u0964','Saturn, Mars, Rahu, Ketu, Sun & Functional Malefics (Lords of 6th, 8th, 12th). Entering (Pravesha) Stambha/Durgantara triggers illness, litigation, or financial loss. Retrograde malefics linger longer and exacerbate danger.')})]}),(0,l.jsxs)(n.View,{style:[c.bulletBox,{backgroundColor:'#E8F5E9',borderColor:'#81C784'}],children:[(0,l.jsxs)(n.Text,{style:[c.bulletTitle,{color:'#2E7D32'}],children:["\ud83d\udfe2 ",b('\u0ab6\u0ac1\u0aad \u0a97\u0acd\u0ab0\u0ab9\u0acb (Benefics)','\u0936\u0941\u092d \u0917\u094d\u0930\u0939 (Benefics)','Benefic Planets'),":"]}),(0,l.jsx)(n.Text,{style:c.bulletText,children:b('\u0a97\u0ac1\u0ab0\u0ac1, \u0ab6\u0ac1\u0a95\u0acd\u0ab0, \u0aac\u0ac1\u0aa7, \u0a95\u0acb\u0a9f\u0abe \u0ab8\u0acd\u0ab5\u0abe\u0aae\u0ac0 \u0a85\u0aa8\u0ac7 \u0a95\u0acb\u0a9f\u0abe \u0aaa\u0abe\u0ab2 \u0a95\u0abf\u0ab2\u0acd\u0ab2\u0abe\u0aa8\u0ac0 \u0ab0\u0a95\u0acd\u0ab7\u0abe \u0a95\u0ab0\u0ac7 \u0a9b\u0ac7 \u0a85\u0aa8\u0ac7 \u0ab8\u0a82\u0a95\u0a9f\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0aac\u0a9a\u0abe\u0ab5\u0ac7 \u0a9b\u0ac7.','\u0917\u0941\u0930\u0941, \u0936\u0941\u0915\u094d\u0930, \u092c\u0941\u0927, \u0915\u094b\u091f\u093e \u0938\u094d\u0935\u093e\u092e\u0940 \u090f\u0935\u0902 \u0915\u094b\u091f\u093e \u092a\u093e\u0932 \u0926\u0941\u0930\u094d\u0917 \u0915\u0940 \u0930\u0915\u094d\u0937\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092c\u0921\u093c\u0947 \u0938\u0902\u0915\u091f \u0938\u0947 \u092c\u091a\u093e\u0924\u0947 \u0939\u0948\u0902\u0964','Jupiter, Venus, Mercury, Kota Swami, and Kota Pala act as divine shields, mitigating malefic afflictions and preserving stability.')})]})]}),(0,l.jsxs)(n.View,{style:c.sectionCard,children:[(0,l.jsxs)(n.Text,{style:c.sectionTitle,children:["\ud83d\udcc8 4. ",b('\u0a9c\u0ac0\u0ab5\u0aa8 \u0aaa\u0ab0 \u0ab6\u0abe\u0ab8\u0acd\u0aa4\u0acd\u0ab0\u0ac0\u0aaf \u0a85\u0aa8\u0ac7 \u0aaa\u0acd\u0ab0\u0aa4\u0acd\u0aaf\u0a95\u0acd\u0ab7 \u0aaa\u0acd\u0ab0\u0aad\u0abe\u0ab5','\u091c\u0940\u0935\u0928 \u092a\u0930 \u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0940\u092f \u090f\u0935\u0902 \u092a\u094d\u0930\u0924\u094d\u092f\u0915\u094d\u0937 \u092a\u094d\u0930\u092d\u093e\u0935','Documented Life Outcomes')]}),(0,l.jsx)(n.Text,{style:c.paragraph,children:b('\u2022 \ud83d\udfe2 \u0a95\u0ab2\u0acd\u0aaf\u0abe\u0aa3\u0a95\u0abe\u0ab0\u0ac0 (Auspicious): \u0a97\u0ac1\u0ab0\u0ac1/\u0ab6\u0ac1\u0a95\u0acd\u0ab0\u0aa8\u0abe \u0a97\u0acb\u0a9a\u0ab0\u0aa5\u0ac0 \u0ab8\u0acd\u0aa4\u0a82\u0aad \u0ab8\u0ac1\u0ab0\u0a95\u0acd\u0ab7\u0abf\u0aa4 \u0ab0\u0ab9\u0ac7\u0aa4\u0abe \u0a86\u0ab0\u0acb\u0a97\u0acd\u0aaf, \u0aaa\u0aa6 \u0a85\u0aa8\u0ac7 \u0aa7\u0aa8 \u0ab2\u0abe\u0aad \u0aa5\u0abe\u0aaf \u0a9b\u0ac7.\n\u2022 \ud83d\udfe0 \u0aae\u0abf\u0ab6\u0acd\u0ab0 (Mixed): \u0a95\u0acd\u0ab0\u0ac2\u0ab0 \u0a97\u0acd\u0ab0\u0ab9 \u0aac\u0abe\u0ab9\u0acd\u0aaf \u0a95\u0acd\u0ab7\u0ac7\u0aa4\u0acd\u0ab0 \u0aa4\u0ab0\u0aab \u0aac\u0ab9\u0abe\u0ab0 \u0aa8\u0ac0\u0a95\u0ab3\u0aa4\u0abe (Nirgamma) \u0ab0\u0abe\u0ab9\u0aa4 \u0aae\u0ab3\u0ac7 \u0a9b\u0ac7.\n\u2022 \ud83d\udd34 \u0a85\u0ab6\u0ac1\u0aad (Inauspicious): \u0ae8 \u0a95\u0ac7 \u0aa4\u0ac7\u0aa5\u0ac0 \u0ab5\u0aa7\u0ac1 \u0a95\u0acd\u0ab0\u0ac2\u0ab0 \u0a97\u0acd\u0ab0\u0ab9\u0acb \u0ab8\u0acd\u0aa4\u0a82\u0aad\u0aae\u0abe\u0a82 \u0aaa\u0acd\u0ab0\u0ab5\u0ac7\u0ab6\u0ac7 \u0aa4\u0acb \u0a86\u0a95\u0ab8\u0acd\u0aae\u0abf\u0a95 \u0ab0\u0acb\u0a97, \u0a95\u0abe\u0aa8\u0ac2\u0aa8\u0ac0 \u0ab8\u0a82\u0a95\u0a9f, \u0aaa\u0aa6\u0aad\u0acd\u0ab0\u0ab7\u0acd\u0a9f\u0aa4\u0abe \u0a95\u0ac7 \u0aa7\u0aa8\u0ab9\u0abe\u0aa8\u0abf \u0aa5\u0abe\u0aaf \u0a9b\u0ac7.','\u2022 \ud83d\udfe2 \u0936\u0941\u092d (Auspicious): \u0917\u0941\u0930\u0941/\u0936\u0941\u0915\u094d\u0930 \u0915\u0947 \u0917\u094b\u091a\u0930 \u0938\u0947 \u0938\u094d\u0924\u0902\u092d \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0939\u0928\u0947 \u092a\u0930 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f, \u092a\u0926 \u090f\u0935\u0902 \u0927\u0928 \u0932\u093e\u092d \u0939\u094b\u0924\u093e \u0939\u0948\u0964\n\u2022 \ud83d\udfe0 \u092e\u093f\u0936\u094d\u0930\u093f\u0924 (Mixed): \u0915\u094d\u0930\u0942\u0930 \u0917\u094d\u0930\u0939 \u092c\u093e\u0939\u094d\u092f \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u0940 \u0913\u0930 \u0928\u093f\u0915\u0932\u0928\u0947 (Nirgamma) \u092a\u0930 \u0930\u093e\u0939\u0924 \u092e\u093f\u0932\u0924\u0940 \u0939\u0948\u0964\n\u2022 \ud83d\udd34 \u0905\u0936\u0941\u092d (Inauspicious): \u0968 \u092f\u093e \u0905\u0927\u093f\u0915 \u0915\u094d\u0930\u0942\u0930 \u0917\u094d\u0930\u0939 \u0938\u094d\u0924\u0902\u092d \u092e\u0947\u0902 \u092a\u094d\u0930\u0935\u0947\u0936 \u0915\u0930\u0947\u0902 \u0924\u094b \u0905\u091a\u093e\u0928\u0915 \u092c\u0940\u092e\u093e\u0930\u0940, \u0915\u093e\u0928\u0942\u0928\u0940 \u0938\u0902\u0915\u091f, \u092a\u0926\u0939\u093e\u0928\u093f \u092f\u093e \u0935\u094d\u092f\u093e\u092a\u093e\u0930 \u0918\u093e\u091f\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964','\u2022 \ud83d\udfe2 Auspicious: Benefics in Stambha grant health, promotion, and financial growth.\n\u2022 \ud83d\udfe0 Mixed: Malefics exiting (Nirgamma) into Bahya bring steady relief.\n\u2022 \ud83d\udd34 Inauspicious: 2+ Malefics invading Stambha precipitate health distress, legal battles, job loss, or financial failure.')})]}),(0,l.jsxs)(n.View,{style:c.sectionCard,children:[(0,l.jsxs)(n.Text,{style:c.sectionTitle,children:["\ud83d\udcdc 5. ",b('\u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aad\u0ac2\u0aa4 \u0a97\u0acd\u0ab0\u0a82\u0aa5\u0acb \u0a85\u0aa8\u0ac7 \u0ab8\u0acd\u0ab0\u0acb\u0aa4','\u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0915 \u0917\u094d\u0930\u0902\u0925 \u090f\u0935\u0902 \u0938\u094d\u0930\u094b\u0924','Classical & Modern Sources')]}),(0,l.jsxs)(n.Text,{style:c.sourcesText,children:["\u2022 Maharshi Parashara (Brihat Parashara Hora Shastra - BPHS)",'\n',"\u2022 Classical Vyavastha Astrology Archives",'\n',"\u2022 Contemporary Research by M. Imran & Nitin Sharma (Vedic Astrology Journal)"]})]})]}),(0,l.jsx)(n.TouchableOpacity,{onPress:u,style:c.doneBtn,activeOpacity:.8,children:(0,l.jsx)(n.Text,{style:c.doneBtnText,children:b('\u0ab8\u0aae\u0a9c\u0abe\u0a88 \u0a97\u0aaf\u0ac1\u0a82','\u0938\u092e\u091d \u0906 \u0917\u092f\u093e','Got It')})})]})})})},n.StyleSheet.create({overlay:{flex:1,backgroundColor:'rgba(0, 0, 0, 0.65)',justifyContent:'flex-end'},modalContainer:{backgroundColor:'#FFFDF6',borderTopLeftRadius:20,borderTopRightRadius:20,maxHeight:'92%',paddingBottom:16},header:{flexDirection:'row',alignItems:'center',justifyContent:'space-between',backgroundColor:'#580017',paddingHorizontal:16,paddingVertical:14,borderTopLeftRadius:20,borderTopRightRadius:20},headerTitleBox:{flex:1},headerTag:{fontSize:11,color:'#FFD700',fontWeight:'700',letterSpacing:.5,textTransform:'uppercase'},headerName:{fontSize:16,color:'#FFFFFF',fontWeight:'800',marginTop:2},closeBtn:{width:32,height:32,borderRadius:16,backgroundColor:'rgba(255, 255, 255, 0.15)',alignItems:'center',justifyContent:'center',marginLeft:12},closeBtnText:{color:'#FFFFFF',fontSize:16,fontWeight:'700'},scrollBody:{padding:16},sectionCard:{backgroundColor:'#FFFFFF',borderRadius:12,padding:14,marginBottom:14,borderWidth:1,borderColor:'#EEEEEE',elevation:1},sectionTitle:{fontSize:14,fontWeight:'800',color:'#580017',marginBottom:8},paragraph:{fontSize:13,color:'#424242',lineHeight:19},bulletBox:{backgroundColor:'#FFEBEE',borderWidth: