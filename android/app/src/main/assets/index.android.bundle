9a\u0a82\u0aa6\u0aa8, \u0aaa\u0ac1\u0ab7\u0acd\u0aaa, \u0aa7\u0ac2\u0aaa, \u0aa6\u0ac0\u0aaa, \u0a85\u0a95\u0acd\u0ab7\u0aa4, \u0aa8\u0ac8\u0ab5\u0ac7\u0aa6\u0acd\u0aaf, \u0aab\u0ab2) \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a86\u0aa4\u0acd\u0aae\u0ab6\u0ac1\u0aa6\u0acd\u0aa7\u0abf \u0a95\u0ab0\u0ab5\u0ac0.','\u092a\u094d\u0930\u093e\u0924\u0903\u0915\u093e\u0932 \u0938\u094d\u0928\u093e\u0928 \u0915\u0947 \u092a\u0936\u094d\u091a\u093e\u0924 \u0936\u0941\u0926\u094d\u0927 \u0935\u0938\u094d\u0924\u094d\u0930 \u0927\u093e\u0930\u0923 \u0915\u0930 \u091c\u093f\u0928 \u092e\u0902\u0926\u093f\u0930 \u091c\u093e\u0915\u0930 \u0924\u0940\u0930\u094d\u0925\u0902\u0915\u0930 \u092a\u0930\u092e\u093e\u0924\u094d\u092e\u093e \u0915\u093e \u0926\u0930\u094d\u0936\u0928-\u092a\u0942\u091c\u0928 \u0915\u0930\u0947\u0902\u0964 \u0905\u0937\u094d\u091f\u092a\u094d\u0930\u0915\u093e\u0930\u0940 \u092a\u0942\u091c\u093e (\u091c\u0932, \u091a\u0902\u0926\u0928, \u092a\u0941\u0937\u094d\u092a, \u0927\u0942\u092a, \u0926\u0940\u092a, \u0905\u0915\u094d\u0937\u0924, \u0928\u0948\u0935\u0947\u0926\u094d\u092f, \u092b\u0932) \u0926\u094d\u0935\u093e\u0930\u093e \u0906\u0924\u094d\u092e\u0936\u0941\u0926\u094d\u0927\u093f \u0915\u0930\u0947\u0902\u0964','Visit the Jin Mandir in pure clothes after morning bath for Tirthankara Darshan & Ashtaprakari Puja (Jal, Chandan, Pushpa, Dhup, Dip, Akshat, Naivedya, Phal).')})]}),(0,T.jsxs)(o.View,{style:k.sectionCard,children:[(0,T.jsxs)(o.Text,{style:k.cardHeaderTitle,children:["\ud83e\udd63 ",mi('\u0aaa\u0a9a\u0acd\u0a9a\u0a95\u0acd\u0a96\u0abe\u0aa3 \u0a85\u0aa8\u0ac7 \u0a86\u0ab0\u0abe\u0aa7\u0aa8\u0abe \u0ab5\u0abf\u0aa7\u0abf','\u092a\u091a\u0915\u094d\u0916\u093e\u0928 \u090f\u0935\u0902 \u0906\u0930\u093e\u0927\u0928\u093e \u0935\u093f\u0927\u093f','Pachkhan & Fasting Rules')]}),(0,T.jsx)(o.Text,{style:k.vidhiBodyText,children:mi('\u2022 \u0aa8\u0ab5\u0a95\u0abe\u0ab0\u0ab6\u0ac0: \u0ab8\u0ac2\u0ab0\u0acd\u0aaf\u0acb\u0aa6\u0aaf\u0aa8\u0abe \u0aea\u0aee \u0aae\u0abf\u0aa8\u0abf\u0a9f \u0aaa\u0a9b\u0ac0 \u0aa8\u0ab5\u0a95\u0abe\u0ab0 \u0aae\u0a82\u0aa4\u0acd\u0ab0 \u0a97\u0aa3\u0ac0 \u0a9c\u0ab2-\u0a86\u0ab9\u0abe\u0ab0 \u0a97\u0acd\u0ab0\u0ab9\u0aa3 \u0a95\u0ab0\u0ab5\u0acb.\n\u2022 \u0a8f\u0a95\u0abe\u0ab8\u0aa3\u0ac1\u0a82: \u0aa6\u0abf\u0ab5\u0ab8\u0aae\u0abe\u0a82 \u0aae\u0abe\u0aa4\u0acd\u0ab0 \u0a8f\u0a95 \u0a9c \u0ab5\u0abe\u0ab0 \u0a8f\u0a95 \u0a9c \u0a86\u0ab8\u0aa8\u0ac7 \u0aac\u0ac7\u0ab8\u0ac0 \u0ab8\u0abe\u0aa4\u0acd\u0ab5\u0abf\u0a95 \u0aad\u0acb\u0a9c\u0aa8 \u0a97\u0acd\u0ab0\u0ab9\u0aa3 \u0a95\u0ab0\u0ab5\u0ac1\u0a82.\n\u2022 \u0a89\u0aaa\u0ab5\u0abe\u0ab8: \u0ab8\u0ac2\u0ab0\u0acd\u0aaf\u0acb\u0aa6\u0aaf\u0aa5\u0ac0 \u0a86\u0a97\u0abe\u0aae\u0ac0 \u0ab8\u0ac2\u0ab0\u0acd\u0aaf\u0acb\u0aa6\u0aaf \u0ab8\u0ac1\u0aa7\u0ac0 \u0a9a\u0abe\u0ab0 \u0a86\u0ab9\u0abe\u0ab0\u0aa8\u0acb \u0aa4\u0acd\u0aaf\u0abe\u0a97 \u0a95\u0ab0\u0ac0 \u0a9c\u0aaa-\u0aa7\u0acd\u0aaf\u0abe\u0aa8 \u0a95\u0ab0\u0ab5\u0ac1\u0a82.','\u2022 \u0928\u0935\u0915\u093e\u0930\u0936\u0940: \u0938\u0942\u0930\u094d\u092f\u094b\u0926\u092f \u0915\u0947 \u096a\u096e \u092e\u093f\u0928\u091f \u092c\u093e\u0926 \u0928\u0935\u0915\u093e\u0930 \u092e\u0902\u0924\u094d\u0930 \u0917\u093f\u0928\u0915\u0930 \u091c\u0932-\u0906\u0939\u093e\u0930 \u0917\u094d\u0930\u0939\u0923 \u0915\u0930\u0947\u0902\u0964\n\u2022 \u090f\u0915\u093e\u0938\u0928: \u0926\u093f\u0928 \u092e\u0947\u0902 \u0915\u0947\u0935\u0932 \u090f\u0915 \u092c\u093e\u0930 \u090f\u0915 \u0939\u0940 \u0906\u0938\u0928 \u092a\u0930 \u092c\u0948\u0920\u0915\u0930 \u0938\u093e\u0924\u094d\u0935\u093f\u0915 \u092d\u094b\u091c\u0928 \u0917\u094d\u0930\u0939\u0923 \u0915\u0930\u0947\u0902\u0964\n\u2022 \u0909\u092a\u0935\u093e\u0938: \u0938\u0942\u0930\u094d\u092f\u094b\u0926\u092f \u0938\u0947 \u0905\u0917\u0932\u0947 \u0938\u0942\u0930\u094d\u092f\u094b\u0926\u092f \u0924\u0915 \u091a\u093e\u0930 \u0906\u0939\u093e\u0930 \u0915\u093e \u0924\u094d\u092f\u093e\u0917 \u0915\u0930 \u091c\u092a-\u0927\u094d\u092f\u093e\u0928 \u0915\u0930\u0947\u0902\u0964','\u2022 Navkarshi: Eat 48 mins after sunrise with Navkar Mantra.\n\u2022 Ekasana: Take pure satvik food only once a day sitting on one seat.\n\u2022 Upvas: Complete 24-hr fasting abstaining from all foods till next sunrise.')})]}),(0,T.jsxs)(o.View,{style:k.sectionCard,children:[(0,T.jsxs)(o.Text,{style:k.cardHeaderTitle,children:["\ud83c\udf3f ",mi('\u0a85\u0ab9\u0abf\u0a82\u0ab8\u0abe \u0a86\u0ab9\u0abe\u0ab0 \u0a85\u0aa8\u0ac7 \u0a95\u0a82\u0aa6\u0aae\u0ac2\u0ab3 \u0aa4\u0acd\u0aaf\u0abe\u0a97','\u0905\u0939\u093f\u0902\u0938\u093e \u0906\u0939\u093e\u0930 \u090f\u0935\u0902 \u0915\u0902\u0926\u092e\u0942\u0932 \u0924\u094d\u092f\u093e\u0917','Ahimsa Diet & Root Vegetable Abstinence')]}),(0,T.jsx)(o.Text,{style:k.vidhiBodyText,children:mi('\u0a9c\u0ac8\u0aa8 \u0aa6\u0ab0\u0acd\u0ab6\u0aa8 \u0a85\u0aa8\u0ac1\u0ab8\u0abe\u0ab0 \u0a9c\u0aae\u0ac0\u0aa8\u0aa8\u0ac0 \u0a85\u0a82\u0aa6\u0ab0 \u0a8a\u0a97\u0aa4\u0abe \u0a95\u0a82\u0aa6\u0aae\u0ac2\u0ab3 (\u0aac\u0a9f\u0abe\u0a9f\u0abe, \u0a95\u0abe\u0a82\u0aa6\u0abe, \u0ab2\u0ab8\u0aa3, \u0a97\u0abe\u0a9c\u0ab0) \u0aae\u0abe\u0a82 \u0a85\u0aa8\u0a82\u0aa4 \u0a95\u0abe\u0aaf \u0a9c\u0ac0\u0ab5 \u0ab9\u0acb\u0aaf \u0a9b\u0ac7, \u0aa4\u0ac7\u0aa5\u0ac0 \u0aa4\u0ac7\u0aae\u0aa8\u0acb \u0ab8\u0a82\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0aa4\u0acd\u0aaf\u0abe\u0a97 \u0a95\u0ab0\u0ab5\u0acb. \u0ab0\u0abe\u0aa4\u0acd\u0ab0\u0abf \u0aad\u0acb\u0a9c\u0aa8 (\u0ab8\u0ac2\u0ab0\u0acd\u0aaf\u0abe\u0ab8\u0acd\u0aa4 \u0aac\u0abe\u0aa6 \u0a86\u0ab9\u0abe\u0ab0) \u0a85\u0ab9\u0abf\u0a82\u0ab8\u0abe \u0ab5\u0acd\u0ab0\u0aa4 \u0aae\u0abe\u0a9f\u0ac7 \u0ab5\u0ab0\u0acd\u0a9c\u0abf\u0aa4 \u0a9b\u0ac7.','\u091c\u0948\u0928 \u0926\u0930\u094d\u0936\u0928 \u0905\u0928\u0941\u0938\u093e\u0930 \u091c\u092e\u0940\u0928 \u0915\u0947 \u0928\u0940\u091a\u0947 \u0909\u0917\u0928\u0947 \u0935\u093e\u0932\u0947 \u0915\u0902\u0926\u092e\u0942\u0932 (\u0906\u0932\u0942, \u092a\u094d\u092f\u093e\u091c, \u0932\u0939\u0938\u0941\u0928, \u0917\u093e\u091c\u0930) \u092e\u0947\u0902 \u0905\u0928\u0902\u0924 \u0915\u093e\u092f \u091c\u0940\u0935 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902, \u0905\u0924\u0903 \u0909\u0928\u0915\u093e \u0938\u0902\u092a\u0942\u0930\u094d\u0923 \u0924\u094d\u092f\u093e\u0917 \u0915\u0930\u0947\u0902\u0964 \u0930\u093e\u0924\u094d\u0930\u093f \u092d\u094b\u091c\u0928 (\u0938\u0942\u0930\u094d\u092f\u093e\u0938\u094d\u0924 \u0915\u0947 \u092c\u093e\u0926 \u0906\u0939\u093e\u0930) \u0905\u0939\u093f\u0902\u0938\u093e \u0935\u094d\u0930\u0924 \u0939\u0947\u0924\u0941 \u0935\u0930\u094d\u091c\u093f\u0924 \u0939\u0948\u0964','Abstain completely from root vegetables (potatoes, onions, garlic) and avoid eating after sunset (Ratri Bhojan Tyag) to uphold Ahimsa.')})]})]}),'FESTIVALS'===N&&(0,T.jsxs)(o.View,{children:[(0,T.jsxs)(o.Text,{style:k.sectionHeaderTitle,children:["\ud83c\udf89 ",mi('\u0a9c\u0ac8\u0aa8 \u0aaa\u0ab0\u0acd\u0ab5 \u0a85\u0aa8\u0ac7 \u0aa4\u0ab9\u0ac7\u0ab5\u0abe\u0ab0\u0acb (\u0a9a\u0abe\u0ab2\u0ac1 \u0aae\u0ab9\u0abf\u0aa8\u0abe\u0aa5\u0ac0)','\u091c\u0948\u0928 \u092a\u0930\u094d\u0935 \u090f\u0935\u0902 \u0924\u094d\u092f\u094b\u0939\u093e\u0930 (\u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u093e\u0939 \u0938\u0947)','Jain Festivals (From Current Month)')]}),Vi.map(function(e){return(0,T.jsxs)(o.View,{style:k.festivalCard,children:[(0,T.jsxs)(o.View,{style:k.festivalTopRow,children:[(0,T.jsxs)(o.Text,{style:k.festivalNameText,children:["\u2638\ufe0f ",mi(e.nameGuj,e.nameHin,e.nameHing)]}),(0,T.jsx)(o.Text,{style:k.festivalDateBadge,children:mi(e.dateStrGuj,e.dateStrHin,e.dateStrHing)})]}),(0,T.jsxs)(o.Text,{style:k.festivalTithiText,children:[mi('\u0aa4\u0abf\u0aa5\u0abf: ','\u0924\u093f\u0925\u093f: ','Tithi: '),mi(e.tithiGuj,e.tithiHin,e.tithiHing)]}),(0,T.jsx)(o.Text,{style:k.festivalSignificText,children:mi(e.significanceGuj,e.significanceHin,e.significanceHing)}),(0,T.jsx)(o.TouchableOpacity,{style:k