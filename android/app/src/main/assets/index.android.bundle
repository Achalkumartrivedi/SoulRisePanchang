u0a97\u0aa6\u0ab0\u0acd\u0ab6\u0aa8',settingsTitle:'\u2699\ufe0f \u0ab8\u0ac7\u0a9f\u0abf\u0a82\u0a97\u0acd\u0ab8 \u0a85\u0aa8\u0ac7 \u0ab8\u0acd\u0aa5\u0abe\u0aa8',settingsSub:'\u0aad\u0abe\u0ab7\u0abe \u0a85\u0aa8\u0ac7 \u0ab8\u0ac2\u0a9a\u0aa8\u0abe\u0a93 \u0aac\u0aa6\u0ab2\u0acb',activeLocation:'\ud83d\udccd \u0ab8\u0a95\u0acd\u0ab0\u0abf\u0aaf \u0ab8\u0acd\u0aa5\u0abe\u0aa8',appLanguage:'\ud83c\udf10 \u0a8f\u0aaa\u0acd\u0ab2\u0abf\u0a95\u0ac7\u0ab6\u0aa8 \u0aad\u0abe\u0ab7\u0abe',liveNotification:'\u23f0 \u0ab2\u0abe\u0a87\u0ab5 \u0a9a\u0acb\u0a98\u0aa1\u0abf\u0aaf\u0abe \u0ab8\u0acd\u0a9f\u0ac7\u0a9f\u0ab8 \u0aac\u0abe\u0ab0 \u0aa8\u0acb\u0a9f\u0abf\u0aab\u0abf\u0a95\u0ac7\u0ab6\u0aa8',liveNotificationSub:'\u0ab8\u0acd\u0a9f\u0ac7\u0a9f\u0ab8 \u0aac\u0abe\u0ab0\u0aae\u0abe\u0a82 \u0a9a\u0acb\u0a98\u0aa1\u0abf\u0aaf\u0abe \u0ab8\u0aae\u0aaf \u0aac\u0aa4\u0abe\u0ab5\u0acb',systemPurnimanta:'\ud83d\udcdc \u0aae\u0abe\u0ab8\u0abf\u0a95 \u0aaa\u0aa6\u0acd\u0aa7\u0aa4\u0abf',systemSub:'\u0aaa\u0ac2\u0ab0\u0acd\u0aa3\u0abf\u0aae\u0abe\u0a82\u0aa4 (\u0aae\u0ab9\u0abf\u0aa8\u0abe\u0aa8\u0acb \u0a85\u0a82\u0aa4 \u0aaa\u0ac2\u0aa8\u0aae\u0ac7 \u0aa5\u0abe\u0aaf \u0a9b\u0ac7)',auspiciousInfoText:'\u0ab6\u0ac1\u0aad \u0ab8\u0aae\u0aaf (\u0a9c\u0ac7\u0aae \u0a95\u0ac7 \u0a85\u0aad\u0abf\u0a9c\u0ac0\u0aa4 \u0a85\u0aa8\u0ac7 \u0aac\u0acd\u0ab0\u0ab9\u0acd\u0aae \u0ab8\u0aae\u0aaf) \u0aa8\u0ab5\u0abe \u0aaa\u0acd\u0ab0\u0acb\u0a9c\u0ac7\u0a95\u0acd\u0a9f\u0acd\u0ab8 \u0a85\u0aa8\u0ac7 \u0a95\u0abe\u0ab0\u0acd\u0aaf\u0acb \u0ab6\u0ab0\u0ac2 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0ab6\u0acd\u0ab0\u0ac7\u0ab7\u0acd\u0aa0 \u0a9b\u0ac7.',inauspiciousInfoText:'\u0a85\u0ab6\u0ac1\u0aad \u0ab8\u0aae\u0aaf (\u0a9c\u0ac7\u0aae \u0a95\u0ac7 \u0ab0\u0abe\u0ab9\u0ac1 \u0a95\u0abe\u0ab3 \u0a85\u0aa8\u0ac7 \u0aaf\u0aae\u0a97\u0a82\u0aa1) \u0aa6\u0ab0\u0aae\u0abf\u0aaf\u0abe\u0aa8 \u0aa8\u0ab5\u0abe \u0a95\u0abe\u0ab0\u0acd\u0aaf\u0acb \u0a85\u0aa8\u0ac7 \u0aaf\u0abe\u0aa4\u0acd\u0ab0\u0abe \u0a9f\u0abe\u0ab3\u0ab5\u0ac0 \u0a9c\u0acb\u0a88\u0a8f.',calendarPopupAbhijitInfo:'\ud83c\udf1f \u0ab6\u0ac1\u0aad \u0aae\u0ac1\u0ab9\u0ac2\u0ab0\u0acd\u0aa4 (\u0a85\u0aad\u0abf\u0a9c\u0ac0\u0aa4): \u0aa8\u0ab5\u0abe \u0a95\u0abe\u0ab0\u0acd\u0aaf\u0acb \u0a85\u0aa8\u0ac7 \u0ab5\u0acd\u0aaf\u0abe\u0aaa\u0abe\u0ab0\u0abf\u0a95 \u0aa8\u0abf\u0ab0\u0acd\u0aa3\u0aaf\u0acb \u0aae\u0abe\u0a9f\u0ac7 \u0ab6\u0acd\u0ab0\u0ac7\u0ab7\u0acd\u0aa0 \u0ab8\u0aae\u0aaf.',calendarPopupRahuInfo:'\u26a0\ufe0f \u0ab0\u0abe\u0ab9\u0ac1 \u0a95\u0abe\u0ab3: \u0aa8\u0ab5\u0abe \u0a95\u0abe\u0ab0\u0acd\u0aaf\u0acb \u0a85\u0aa8\u0ac7 \u0aaf\u0abe\u0aa4\u0acd\u0ab0\u0abe \u0ab6\u0ab0\u0ac2 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0a9f\u0abe\u0ab3\u0ab5\u0ac1\u0a82.',purnimaAmavasyaHeader:'\ud83c\udf15 \u0aae\u0abe\u0ab8\u0abf\u0a95 \u0aaa\u0ac2\u0aa8\u0aae \u0a85\u0aa8\u0ac7 \u0a85\u0aae\u0abe\u0ab8 \u0ab5\u0abf\u0a97\u0aa4\u0acb',purnimaTitle:'\ud83c\udf15 \u0aaa\u0ac2\u0aa8\u0aae (\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0a9a\u0a82\u0aa6\u0acd\u0ab0)',amavasyaTitle:'\ud83c\udf11 \u0a85\u0aae\u0abe\u0ab8 (\u0aa8\u0ab5\u0acb \u0a9a\u0a82\u0aa6\u0acd\u0ab0)',purnimaRitual:'\u0ab8\u0aa4\u0acd\u0aaf\u0aa8\u0abe\u0ab0\u0abe\u0aaf\u0aa3 \u0ab5\u0acd\u0ab0\u0aa4 \u0a95\u0aa5\u0abe \u0a85\u0aa8\u0ac7 \u0a9a\u0a82\u0aa6\u0acd\u0ab0 \u0aa6\u0ab0\u0acd\u0ab6\u0aa8 \u0aaa\u0ac2\u0a9c\u0abe',amavasyaRitual:'\u0aaa\u0abf\u0aa4\u0ac3 \u0aa4\u0ab0\u0acd\u0aaa\u0aa3, \u0aa6\u0abe\u0aa8 \u0a85\u0aa8\u0ac7 \u0aaa\u0ab5\u0abf\u0aa4\u0acd\u0ab0 \u0ab8\u0acd\u0aa8\u0abe\u0aa8',tithiStarts:'\u0aa4\u0abf\u0aa5\u0abf \u0ab6\u0ab0\u0ac2\u0a86\u0aa4',tithiEnds:'\u0ab8\u0aae\u0abe\u0aaa\u0acd\u0aa4\u0abf',reminderSectionTitle:'\ud83d\udd14 \u0aaa\u0ac2\u0aa8\u0aae \u0a85\u0aa8\u0ac7 \u0a85\u0aae\u0abe\u0ab8 \u0a86\u0a97\u0aae\u0aa8 \u0ab0\u0abf\u0aae\u0abe\u0a87\u0aa8\u0acd\u0aa1\u0ab0',purnimaReminderLabel:'\ud83c\udf15 \u0aaa\u0ac2\u0aa8\u0aae \u0ab0\u0abf\u0aae\u0abe\u0a87\u0aa8\u0acd\u0aa1\u0ab0 \u0aa8\u0a