930\u0935\u093e\u0939',O='Healthy equilibrium between professional efforts, earnings, and asset retention.',G='\u0906\u092a\u0915\u0947 \u0915\u093e\u0930\u094d\u092f, \u0906\u092f \u092a\u094d\u0930\u0935\u093e\u0939 \u0914\u0930 \u092c\u091a\u0924 \u092e\u0947\u0902 \u0938\u094d\u0935\u0938\u094d\u0925 \u0938\u0902\u0924\u0941\u0932\u0928 \u092c\u0928\u093e \u0939\u0941\u0906 \u0939\u0948\u0964';j&&K?(_='High Labor with Capital Attrition (Double Deficit)',O=`Your 10th House (${$} pts) exceeds your 11th House (${q} pts), indicating extensive visible professional exertion with delayed monetization. Additionally, your 12th House (${Y} pts) exceeds your 11th, signaling recurring capital drain. Automate savings and enforce strict written terms for all commercial work.`,G=`\u0906\u092a\u0915\u093e 10\u0935\u093e\u0902 \u092d\u093e\u0935 (${$} \u0905\u0902\u0915) 11\u0935\u0947\u0902 \u092d\u093e\u0935 (${q} \u0905\u0902\u0915) \u0938\u0947 \u0905\u0927\u093f\u0915 \u0939\u0948, \u091c\u094b \u0926\u0930\u094d\u0936\u093e\u0924\u093e \u0939\u0948 \u0915\u093f \u092e\u0947\u0939\u0928\u0924 \u0905\u0927\u093f\u0915 \u0939\u0948 \u092a\u0930 \u0909\u0938\u0915\u093e \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u092a\u094d\u0930\u0924\u093f\u092b\u0932 \u0926\u0947\u0930 \u0938\u0947 \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964 \u0938\u093e\u0925 \u0939\u0940 12\u0935\u093e\u0902 \u092d\u093e\u0935 (${Y} \u0905\u0902\u0915) 11\u0935\u0947\u0902 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0939\u094b\u0928\u0947 \u0938\u0947 \u0905\u092a\u094d\u0930\u0924\u094d\u092f\u093e\u0936\u093f\u0924 \u0916\u0930\u094d\u091a \u092c\u091a\u0924 \u0915\u094b \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u092e\u092f \u092a\u0930 \u092c\u091a\u0924 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0915\u0930\u0947\u0902\u0964`):j?(_='Unreciprocated Exertion Warning',z='\u092a\u0930\u093f\u0936\u094d\u0930\u092e \u0915\u0947 \u0905\u0928\u0941\u092a\u093e\u0924 \u092e\u0947\u0902 \u0935\u093f\u0932\u0902\u092c\u093f\u0924 \u0932\u093e\u092d',O=`10th House of career labor (${$} pts) exceeds 11th House of gains (${q} pts). You tend to exert substantial professional energy, but direct monetization requires deliberate structuring and active negotiation.`,G=`\u0915\u093e\u0930\u094d\u092f \u0915\u093e 10\u0935\u093e\u0902 \u092d\u093e\u0935 (${$} \u0905\u0902\u0915) \u0932\u093e\u092d \u0915\u0947 11\u0935\u0947\u0902 \u092d\u093e\u0935 (${q} \u0905\u0902\u0915) \u0938\u0947 \u092c\u0921\u093c\u093e \u0939\u0948\u0964 \u0906\u092a\u0915\u0940 \u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u092e\u0947\u0939\u0928\u0924 \u092c\u0939\u0941\u0924 \u0905\u0927\u093f\u0915 \u0930\u0939\u0924\u0940 \u0939\u0948, \u092a\u0930\u0902\u0924\u0941 \u0909\u0938\u0915\u0947 \u092a\u0942\u0930\u094d\u0923 \u0935\u093f\u0924\u094d\u0924\u0940\u092f \u0926\u094b\u0939\u0928 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u094b \u0938\u0915\u094d\u0930\u093f\u092f \u092e\u094b\u0932\u092d\u093e\u0935 \u0935 \u092f\u094b\u091c\u0928\u093e\u092c\u0926\u094d\u0927 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0928\u0947 \u0939\u094b\u0902\u0917\u0947\u0964`):K?(_='Capital Leakage Warning',z='\u092a\u0942\u0902\u091c\u0940 \u0915\u094d\u0937\u092f \u090f\u0935\u0902 \u0935\u094d\u092f\u092f \u0938\u0924\u0930\u094d\u0915\u0924\u093e',O=`12th House of expenditure (${Y} pts) rivals or exceeds 11th House of gains (${q} pts). While revenue flows in, unexpected domestic or health liabilities can erode savings. Automate your investments.`,G=`\u0935\u094d\u092f\u092f \u0915\u093e 12\u0935\u093e\u0902 \u092d\u093e\u0935 (${Y} \u0905\u0902\u0915) \u0932\u093e\u092d \u0915\u0947 11\u0935\u0947\u0902 \u092d\u093e\u0935 (${q} \u0905\u0902\u0915) \u0915\u0947 \u0932\u0917\u092d\u0917 \u092c\u0930\u093e\u092c\u0930 \u092f\u093e \u0905\u0927\u093f\u0915 \u0939\u0948\u0964 \u0906\u092f \u0924\u094b \u0906\u0924\u0940 \u0939\u0948, \u092a\u0930\u0902\u0924\u0941 \u0905\u091a\u093e\u0928\u0915 \u0906\u0928\u0947 \u0935\u093e\u0932\u0947 \u092a\u093e\u0930\u093f\u0935\u093e\u0930\u093f\u0915 \u092f\u093e \u091a\u093f\u0915\u093f\u0924\u094d\u0938\u0915\u0940\u092f \u0916\u0930\u094d\u091a\u0947 \u092c\u091a\u0924 \u0915\u094b \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u091a\u0924 \u0915\u094b \u092a\u0939\u0932\u0947 \u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0947\u0902\u0964`):(_='Prosperous Monetization Triad',z='\u0909\u0924\u094d\u0915\u0943\u0937\u094d\u091f \u0927\u0928\u094b\u092a\u093e\u0930\u094d\u091c\u0928 \u0935 \u0938\u0902\u091a\u092f \u092f\u094b\u0917',O=`11th House of gains (${q} pts) comfortably surpasses 10th House (${$} pts) and 12th House (${Y} pts). Your professional labor converts efficiently into financial assets and sustained surplus.`,G=`\u0932\u093e\u092d \u0915\u093e 11\u0935\u093e\u0902 \u092d\u093e\u0935 (${q} \u0905\u0902\u0915) 10\u0935\u0947\u0902 \u092d\u093e\u0935 (${$} \u0905\u0902\u0915) \u0914\u0930 12\u0935\u0947\u0902 \u092d\u093e\u0935 (${Y} \u0905\u0902\u0915) \u0938\u0947 \u0905\u0927\u093f\u0915 \u0939\u0948\u0964 \u0906\u092a\u0915\u093e \u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u092a\u0930\u093f\u0936\u094d\u0930\u092e \u092c\u0939\u0941\u0924 \u0939\u0940 \u092a\u094d\u0930\u092d\u093e\u0935\u0936\u093e\u0932\u0940 \u0930\u0942\u092a \u0938\u0947 \u0927\u0928 \u0932\u093e\u092d \u0914\u0930 \u0938\u094d\u0925\u093e\u092f\u0940 \u092c\u091a\u0924 \u092e\u0947\u0902 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u093f\u0924 \u0939\u094b\u0924\u093e \u0939\u0948\u0964`);var W=S[5].points,U=S[7].points,X=W+U+Y,Q=X<76,Z=Q?'Hazard Containment (Teertha Protected)':'Systemic Vulnerability Awareness',ee=Q?'\u0938\u0902\u0915\u091f \u0935 \u0935\u094d\u092f\u093e\u0927\u093f \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 (\u0924\u0940\u0930\u094d\u0925 \u0928\u093f\u092f\u092e \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924)':'\u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0935 \u0924\u0928\u093e\u0935 \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u0938\u091c\u0917\u0924\u093e',ie=Q?`The aggregate score of your Dusthanas (6th + 8th + 12th = ${X} pts) is under the classical 76-point baseline. Involuntary losses, legal hurdles, and chronic illnesses are structurally suppressed and cannot easily derail you.`:`The aggregate score of your Dusthanas (6th + 8th + 12th = ${X} pts) exceeds 76 points. Chronic stress, digestive fatigue, or disputes require proactive management, disciplined health habits, and transparent contracts.`,ae=Q?`\u0906\u092a\u0915\u0947 \u0924\u094d\u0930\u093f\u0915 \u092d\u093e\u0935\u094b\u0902 (6\u0920\u0947 + 8\u0935\u0947\u0902 + 12\u0935\u0947\u0902 \u092d\u093e\u0935) \u0915\u093e \u0915\u0941\u0932 \u092f\u094b\u0917 ${X} \u0905\u0902\u0915 \u0939\u0948, \u091c\u094b \u0936\u093e\u0938\u094d\u0924\u094d\u0930\u0940\u092f 76-\u0905\u0902\u0915 \u0915\u0940 \u0938\u0940\u092e\u093e \u0938\u0947 \u0915\u092e \u0939\u0948\u0964 \u0915\u093e\u0928\u0942\u0928\u0940 \u0935\u093f\u0935\u093e\u0926, \u0905\u092a\u094d\u0930\u0924\u094d\u092f\u093e\u0936\u093f\u0924 \u0939\u093e\u0928\u093f\u092f\u093e\u0901 \u0914\u0930 \u0932\u0902\u092c\u0940 \u092c\u0940\u092e\u093e\u0930\u093f\u092f\u093e\u0901 \u0906\u092a\u0915\u0947 \u091c\u0940\u0935\u0928 \u0915\u094b \u0906\u0938\u093e\u0928\u0940 \u0938\u0947 \u0905\u0938\u094d\u0925\u093f\u0930 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0940\u0902\u0964`:`\u0906\u092a\u0915\u0947 \u0924\u094d\u0930\u093f\u0915 \u092d\u093e\u0935\u094b\u0902 (6\u0920\u0947 + 8\u0935\u0947\u0902 + 12\u0935\u0947\u0902 \u092d\u093e\u0935) \u0915\u093e \u0915\u0941\u0932 \u092f\u094b\u0917 ${X} \u0905\u0902\u0915 \u0939\u0948, \u091c\u094b 76 \u0905\u0902\u0915 \u0938\u0947 \u0905\u0927\u093f\u0915 \u0939\u0948\u0964 \u0924\u0928\u093e\u0935, \u092a\u093e\u091a\u0928 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0914\u0930 \u0915\u093e\u0928\u0942\u0928\u0940/\u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u0938\u092e\u091d\u094c\u0924\u094b\u0902 \u092e\u0947\u0902 \u092a\u093e\u0930\u0926\u0930\u094d\u0936\u093f\u0924\u093e \u0914\u0930 \u0928\u093f\u092f\u092e\u093f\u0924 \u0938\u094d\u0935\u093e\u0938\u094d\u0925\u094d\u092f \u0926\u093f\u0928\u091a\u0930\u094d\u092f\u093e \u092c\u0928\u093e\u090f \u0930\u0916\u0928\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964`,te=Array.from({length:12},function(i,n){return{rashiIndex:n,rashiName:s[n],rashiHindi:o[n],points:h[n],band:t(h[n])}});return{totalPoints:337,averagePerHouse:28.08,houses:S,signs:te,bav:p,executiveSummary:{prosperousHouses:k,balancedHouses:A,effortHeavyHouses:M,financialTriad:{karmaHouse10Points:$,labhaHouse11Points:q,vyayaHouse12Points:Y,dhanaHouse2Points:J,laborMonetizationBalance:j?'UNRECIPROCATED_EFFORT':'EXCELLENT',capitalRetentionBalance:K?'CAPITAL_LEAKAGE':'STRONG_RETENTION',titleEn:_,titleHi:z,explanationEn:O,explanationHi:G},dusthanaTriad:{house6Points:W,house8Points:U,house12Points:Y,totalSum:X,isProtected:Q,titleEn:Z,titleHi:ee,explanationEn:ie,explanationHi:ae}}}},e.getSAVBand=t;var i=e.SAV_BANDS={SHRESTHA:{type:'SHRESTHA',labelEn:'Shrestha (Fortified)',labelHi:'\u0936\u094d\u0930\u0947\u0937\u094d\u0920 (\u0905\u0924\u094d\u092f\u0902\u0924 \u0936\u0941\u092d)',rangeStr:'\u226530 Points',color:'#2E7D32',bgColor:'#E8F5E9',borderColor:'#81C784',lightTextColor:'#1B5E20'},MADHYAMA:{type:'MADHYAMA',labelEn:'Madhyama (Moderate)',labelHi:'\u092e\u0927\u094d\u092f\u092e (\u0938\u0902\u0924\u0941\u0932\u093f\u0924)',rangeStr:'25\u201329 Points',color:'#E65100',bgColor:'#FFF8E1',borderColor:'#FFD54F',lightTextColor:'#B78103'},ALPA:{type:'ALPA',labelEn:'Alpa / Kashta (Deficient)',labelHi:'\u0905\u0932\u094d\u092a / \u0915\u0937\u094d\u091f (\u092e\u0947\