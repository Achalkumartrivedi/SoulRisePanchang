abf\u0aae\u0abe\u0a9a\u0ab2 \u0aaa\u0acd\u0ab0\u0aa6\u0ac7\u0ab6)',dateIso:'2026-10-21',category:'MAJOR_FESTIVAL',deity:'Lord Raghunath (Shri Rama)',description:'World-famous 7-day international festival of Kullu Valley starting on Vijayadashami day.',rituals:'Grand Rath Yatra of Lord Raghunath, congregation of over 200 local hill deities (Devtas).',tithiDescription:'Ashwina Shukla Dashami',region:'Himachal Pradesh',isHoliday:!0},{id:'f_jk_herath',name:'\ud83d\udd31 Herath (Kashmiri Pandit Shivratri)',hindiName:'\ud83d\udd31 \u0939\u0947\u0930\u093e\u0925 (\u0915\u0936\u094d\u092e\u0940\u0930\u0940 \u092a\u0902\u0921\u093f\u0924 \u0936\u093f\u0935\u0930\u093e\u0924\u094d\u0930\u093f)',gujaratiName:'\ud83d\udd31 \u0ab9\u0ac7\u0ab0\u0abe\u0aa5 (\u0a95\u0ab6\u0acd\u0aae\u0ac0\u0ab0\u0ac0 \u0ab6\u0abf\u0ab5\u0ab0\u0abe\u0aa4\u0acd\u0ab0\u0abf)',dateIso:'2026-02-15',category:'MAJOR_FESTIVAL',deity:'Lord Shiva & Mata Parvati',description:'Most sacred 3-day festival of Kashmiri Pandits celebrating the divine marriage of Hara & Girija.',rituals:'Vatuk Puja with water-filled vessels (Kalash), offering walnuts (Doon), distributing Prasad.',tithiDescription:'Phalguna Krishna Trayodashi (Kashmiri Panchang)',region:'Jammu & Kashmir',isHoliday:!0}]).sort(function(a,t){var n=new Date(a.dateIso+'T00:00:00Z').getTime(),s=new Date(t.dateIso+'T00:00:00Z').getTime();return n!==s?n-s:a.name.localeCompare(t.name)})},696,[]);
